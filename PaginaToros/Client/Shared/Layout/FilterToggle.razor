@* Botón que muestra u oculta los filtros por columna de la grilla. Queda marcado mientras están visibles. *@
<button type="button"
        class="pt-btn pt-btn--secondary @(Active ? "is-active" : null)"
        aria-pressed="@(Active ? "true" : "false")"
        title="@(Active ? "Ocultar filtros por columna" : "Mostrar filtros por columna")"
        disabled="@Disabled"
        @onclick="OnToggle">
    <FeatherFilter Size="16" Color="currentColor" />
    <span>Filtros</span>
</button>

@code {
    [Parameter] public bool Active { get; set; }

    [Parameter] public EventCallback OnToggle { get; set; }

    [Parameter] public bool Disabled { get; set; }
}
