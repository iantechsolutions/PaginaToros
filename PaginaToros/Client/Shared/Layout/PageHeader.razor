@* Encabezado de página: título (y descripción opcional) a la izquierda, acciones a la derecha.
   En pantallas angostas las acciones bajan debajo del título. *@
<header class="pt-page-header @Class">
    <div class="pt-page-heading">
        <h1 class="pt-page-title">@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="pt-page-description">@Description</p>
        }
    </div>
    @if (ChildContent is not null)
    {
        <div class="pt-page-actions">
            @ChildContent
        </div>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public string? Description { get; set; }

    /// <summary>Acciones de la página (crear, reportes, filtros…). La acción principal va al final.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string? Class { get; set; }
}
