@page "/reportes"
@using PaginaToros.Shared.Models.Response
@using PaginaToros.Shared.Models
@using PaginaToros.Client.Servicios.Contrato;
@inject IResin1Servicio _resin1Servicio

<style>
    .empty-state {
        padding: 3rem 1rem;
        text-align: center;
        color: #475569;
        border: 1px dashed #cbd5e1;
        border-radius: 8px;
        background: #f8fafc;
    }

    .rz-cell-data,
    .rz-column-title-content {
        font-size: 13px !important;
    }

    .rz-cell-data {
        overflow: visible !important;
        white-space: normal !important;
    }

    .tablacontent th.rz-unselectable-text.rz-text-align-left {
        background-color: #82D682;
    }

    .rz-paginator {
        border-top: solid #E0E0E0 1px;
    }
</style>

<div class="pt-page">
    <AuthorizeView Roles="ADMINISTRADOR,USUARIOMAESTRO,Socio">
        <Authorized Context="reportesUser">
            <PageHeader Title="Reportes de inspección" Description="Buscá por número, plantel, socio, establecimiento o fecha de creación.">
                <AuthorizeView Roles="ADMINISTRADOR,USUARIOMAESTRO">
                    <Authorized Context="reportesAdminButton">
                        <button type="button" class="pt-btn pt-btn--primary" @onclick="() => add(0, 0)">
                            <FeatherPlus Size="16" Color="currentColor" />
                            <span>Agregar reporte</span>
                        </button>
                    </Authorized>
                </AuthorizeView>
            </PageHeader>

            <PageToolbar>
                <Search>
                    <SearchInput Value="@searchText"
                                 ValueChanged="OnSearchChanged"
                                 IsLoading="@searchLoading"
                                 Placeholder="Buscar por número, plantel, socio, establecimiento o fecha" />
                </Search>
                <ChildContent>
                    <SortSelector Sort="sort" OnChange="OnSortChanged" />
                </ChildContent>
            </PageToolbar>

            <AuthorizeView Roles="ADMINISTRADOR,USUARIOMAESTRO">
                <Authorized Context="reportesAdminGrid">
                    <div class="tablacontent pt-grid">
                        <RadzenDataGrid @ref="grid"
                                        IsLoading="@isLoading"
                                        AllowColumnResize="true"
                                        AllowSorting="false"
                                        AllowPaging="true"
                                        ShowPagingSummary="true"
                                        PageSize="15"
                                        Density="Density.Compact"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        LogicalFilterOperator="LogicalFilterOperator.Or"
                                        LoadData="LoadData"
                                        Data="@items"
                                        Count="@cantidad"
                                        TItem="Resin1DTO"
                                        ColumnWidth="3.33%">
                            <EmptyTemplate>
                                <div class="empty-state">No hay reportes para la búsqueda seleccionada.</div>
                            </EmptyTemplate>
                            <Columns>
                                <RadzenDataGridColumn TItem="Resin1DTO" Property="Nrores" Title="Nro Resultado" Width="21.7%">
                                    <HeaderTemplate><SortableHeader Sort="sort" Field="Nrores" Title="Nro Resultado" OnChange="OnSortChanged" /></HeaderTemplate>
                                    <Template Context="data">
                                        @(string.IsNullOrWhiteSpace(data.Nrores) ? "Sin solicitud" : data.Nrores)
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Resin1DTO" Property="Nropla" Title="Plantel" Width="21.7%">
                                    <HeaderTemplate><SortableHeader Sort="sort" Field="Nropla" Title="Plantel" OnChange="OnSortChanged" /></HeaderTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Resin1DTO" Property="Socio.Nombre" Title="Socio" Width="21.7%">
                                    <HeaderTemplate><SortableHeader Sort="sort" Field="Socio.Nombre" Title="Socio" OnChange="OnSortChanged" /></HeaderTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Resin1DTO" Property="FchUsu" Title="Fecha de Creación" Width="21.7%">
                                    <HeaderTemplate><SortableHeader Sort="sort" Field="FchUsu" Title="Fecha de Creación" OnChange="OnSortChanged" /></HeaderTemplate>
                                    <Template Context="data">
                                        @if (data.FchUsu.HasValue)
                                        {
                                            @data.FchUsu.Value.ToString("dd/MM/yyyy")
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Resin1DTO" Property="Freali" Title="Fecha De Inspeccion" Width="21.7%">
                                    <HeaderTemplate><SortableHeader Sort="sort" Field="Freali" Title="Fecha de Inspección" OnChange="OnSortChanged" /></HeaderTemplate>
                                    <Template Context="data">
                                        @if (data.Freali.HasValue)
                                        {
                                            @data.Freali.Value.ToString("dd/MM/yyyy")
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Resin1DTO" Property="" Title="" Filterable="false" Width="3.33%">
                                    <Template Context="data">
                                        <button class="btn" title="Editar" @onclick="() => add(data.Id, 0)"><FeatherEdit Size="16" Color="green" /></button>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Resin1DTO" Property="" Title="" Filterable="false" Width="3.33%">
                                    <Template Context="data">
                                        <button class="btn" title="Eliminar" @onclick="() => alertaDelete(data.Id)"><FeatherTrash Size="16" Color="red" /></button>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Socio">
                <Authorized Context="reportesSocioGrid">
                    <div class="tablacontent pt-grid">
                        <RadzenDataGrid @ref="grid"
                                        IsLoading="@isLoading"
                                        AllowColumnResize="true"
                                        AllowSorting="false"
                                        AllowPaging="true"
                                        ShowPagingSummary="true"
                                        PageSize="15"
                                        Density="Density.Compact"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        LogicalFilterOperator="LogicalFilterOperator.Or"
                                        LoadData="LoadData"
                                        Data="@items"
                                        Count="@cantidad"
                                        TItem="Resin1DTO"
                                        ColumnWidth="3.33%">
                            <EmptyTemplate>
                                <div class="empty-state">No hay reportes para la búsqueda seleccionada.</div>
                            </EmptyTemplate>
                            <Columns>
                                <RadzenDataGridColumn TItem="Resin1DTO" Property="Nrores" Title="Nro Resultado" Width="21.7%">
                                    <HeaderTemplate><SortableHeader Sort="sort" Field="Nrores" Title="Nro Resultado" OnChange="OnSortChanged" /></HeaderTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Resin1DTO" Property="Nropla" Title="Plantel" Width="21.7%">
                                    <HeaderTemplate><SortableHeader Sort="sort" Field="Nropla" Title="Plantel" OnChange="OnSortChanged" /></HeaderTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Resin1DTO" Property="Establecimiento.Nombre" Title="Establecimiento" Width="21.7%">
                                    <HeaderTemplate><SortableHeader Sort="sort" Field="Establecimiento.Nombre" Title="Establecimiento" OnChange="OnSortChanged" /></HeaderTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Resin1DTO" Property="FchUsu" Title="Fecha de Creación" Width="21.7%">
                                    <HeaderTemplate><SortableHeader Sort="sort" Field="FchUsu" Title="Fecha de Creación" OnChange="OnSortChanged" /></HeaderTemplate>
                                    <Template Context="data">
                                        @if (data.FchUsu.HasValue)
                                        {
                                            @data.FchUsu.Value.ToString("dd/MM/yyyy")
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Resin1DTO" Property="Freali" Title="Fecha De Inspeccion" Width="21.7%">
                                    <HeaderTemplate><SortableHeader Sort="sort" Field="Freali" Title="Fecha de Inspección" OnChange="OnSortChanged" /></HeaderTemplate>
                                    <Template Context="data">
                                        @if (data.Freali.HasValue)
                                        {
                                            @data.Freali.Value.ToString("dd/MM/yyyy")
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Resin1DTO" Property="" Title="" Filterable="false" Width="3.33%">
                                    <Template Context="data">
                                        <button class="btn" title="Editar" @onclick="() => add(data.Id, 1)"><FeatherEdit Size="16" Color="green" /></button>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                </Authorized>
            </AuthorizeView>
        </Authorized>
    </AuthorizeView>
</div>


@code {
    [CascadingParameter] public IModalService Modal { get; set; } = default!;
    public RadzenDataGrid<Resin1DTO>? grid;

    private List<Resin1DTO> items = new();
    private bool isLoading;
    private bool searchLoading;
    private int cantidad;
    private string searchText = string.Empty;
    private int loadRequestVersion;
    private bool initialGridLoadTriggered;

    // Orden inicial: último resultado cargado primero (id). FCH_USU ("Fecha de Creación") no sirve
    // para eso: los resultados cargados por la app antes de junio de 2026 lo tienen vacío.
    private ListSort sort = CrearOrden(esSocio: false);

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var esSocio = user.IsInRole("Socio") && !user.IsInRole("ADMINISTRADOR") && !user.IsInRole("USUARIOMAESTRO");
        if (esSocio)
        {
            sort = CrearOrden(esSocio: true);
        }
    }

    // Los campos coinciden con la Property de cada columna y con Resin1Repositorio.Sort*.
    private static ListSort CrearOrden(bool esSocio) => new(
        new[]
        {
            new SortField("Id", "Orden de carga", SortValueKind.Date, "Primeros cargados primero", "Últimos cargados primero"),
            new SortField("Nrores", "Nro resultado", SortValueKind.Number),
            new SortField("Nropla", "Plantel", SortValueKind.Text),
            esSocio
                ? new SortField("Establecimiento.Nombre", "Establecimiento", SortValueKind.Text)
                : new SortField("Socio.Nombre", "Socio", SortValueKind.Text),
            new SortField("FchUsu", "Fecha de creación", SortValueKind.Date),
            new SortField("Freali", "Fecha de inspección", SortValueKind.Date),
        },
        defaultKey: "Id",
        defaultDescending: true);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || initialGridLoadTriggered || grid == null)
        {
            return;
        }

        initialGridLoadTriggered = true;
        await grid.Reload();
    }

    private async Task LoadData(LoadDataArgs args)
    {
        var requestId = ++loadRequestVersion;
        isLoading = true;

        try
        {
            var response = await _resin1Servicio.SearchPaged(args.Skip ?? 0, args.Top ?? 15, searchText, sort.Key, sort.Descending);
            if (requestId != loadRequestVersion)
            {
                return;
            }

            items = response.List?.Items ?? new List<Resin1DTO>();
            cantidad = response.List?.TotalCount ?? 0;
        }
        catch (Exception ex)
        {
            items = new List<Resin1DTO>();
            cantidad = 0;
            await Swal.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            if (requestId == loadRequestVersion)
            {
                isLoading = false;
                searchLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task OnSearchChanged(string value)
    {
        searchLoading = true;
        searchText = value ?? string.Empty;
        await ReloadGridFromStartAsync();
    }

    // Al cambiar el orden se vuelve a la primera página: seguir en la página N de otro orden
    // muestra registros sin relación con los que se estaban viendo.
    private Task OnSortChanged() => ReloadGridFromStartAsync();

    private async Task ReloadGridFromStartAsync()
    {
        if (grid != null)
        {
            if (grid.CurrentPage > 0)
            {
                await grid.FirstPage(true);
            }
            else
            {
                await grid.Reload();
            }
        }
    }

    async Task delete(int id)
    {
        var response = await _resin1Servicio.Eliminar(id);
        if (response)
        {
            await ReloadGridFromStartAsync();
        }
    }

    public async Task alertaDelete(int id)
    {
        SweetAlertResult result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "¿Está seguro?",
            Text = "Se eliminará el reporte",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Eliminar",
            CancelButtonText = "Cancelar"
        });

        if (!string.IsNullOrEmpty(result.Value))
        {
            await delete(id);
        }
    }

    async Task add(int Id, int esSocio)
    {
        nav.NavigateTo($"/inforeporte/{Id}/{esSocio}");
    }
}
