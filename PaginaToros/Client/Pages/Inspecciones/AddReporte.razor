async Task<bool> ResultWithoutSolicitud()
{
    Console.WriteLine("ResultWithoutSolicitud");

    // El tilde se consume de forma sincronica: si quedaba prendido durante los awaits, una segunda
    // pasada por el circuito volvia a forzar la creacion de otro plantel para el mismo socio y año.
    var debeCrearPlantel = createNewPlantel;
    createNewPlantel = false;
    var ok = false;

    try
    {
        // 1) Validaciones básicas
        if (socioSeleccionado is null)
        {
            await Swal.FireAsync("Error", "Debe seleccionar un socio.", SweetAlertIcon.Error);
            return false;
        }

        var codEst = establecimientos.FirstOrDefault(x => x.Codsoc == socioSeleccionado.Scod)?.Ecod;
        if (string.IsNullOrWhiteSpace(codEst))
        {
            await Swal.FireAsync("Error", "El socio no tiene establecimientos cargados.", SweetAlertIcon.Error);
            return false;
        }

        if (inspectorSeleccionado is null)
        {
            await Swal.FireAsync("Error", "Debe seleccionar un inspector.", SweetAlertIcon.Error);
            return false;
        }

        // 2) Tomar plantel base (para 'Existencia anterior'), pero SIN pisar selección del usuario
        PlantelDTO? plantel = Plantelseleccionado;

        if (plantel is null)
        {
            // Primero buscar por el mismo año de la fecha de inspección
            var anio = fechaTemp.Year.ToString();
            plantel = Planteles
                .Where(x => x.Nrocri == socioSeleccionado.Scod && x.Anioex == anio)
                .FirstOrDefault()
                ?? Planteles
                    .Where(x => x.Nrocri == socioSeleccionado.Scod)
                    .FirstOrDefault();
        }

        if (plantel is null)
        {
            await Swal.FireAsync("Error", "El socio no tiene plantel registrado.", SweetAlertIcon.Error);
            return false;
        }

        Plantelseleccionado = plantel;

        // 2.1) Mostrar tabs y loaders ya mismo
        loadingMovs = loadingHemyma = loadingProms = loadingRech = true;
        confirmado = true;
        isSavingReporte = true;
        await InvokeAsync(StateHasChanged);

        // 3) Crear Resin1 dejando que el servidor asigne el nro correlativo si corresponde
        solicitudSeleccionada = new List<Solici1DTO?>();
        oResin1 = new Resin1DTO
        {
            Nrores = null,
            Estcod = codEst,
            Scod = socioSeleccionado.Scod,
            Icod = inspectorSeleccionado.Icod,
            Nropla = plantel.Placod,
            Freali = fechaTemp
        };

        var guardado = await guardarReporte();
        if (guardado is null || string.IsNullOrWhiteSpace(guardado.Nrores))
        {
            await Swal.FireAsync("Error", "No se pudo crear el resultado de inspección.", SweetAlertIcon.Error);
            loadingMovs = loadingHemyma = loadingProms = loadingRech = false;
            isSavingReporte = false;
            await InvokeAsync(StateHasChanged);
            return false;
        }

        Id = guardado.Id;
        oResin1 = guardado;

        // 4) Crear histórico desde Plantel y refrescar secciones con el nro real
        solicitudSeleccionada = new List<Solici1DTO?>
        {
            new Solici1DTO { Nrosol = guardado.Nrores, Codest = codEst, Fecsol = guardado.Freali ?? DateTime.Now }
        };

        await crearHistorico(guardado.Nrores);
        await RefreshAll(guardado.Nrores);

        // 5) Crear/actualizar plantel si corresponde
        if (debeCrearPlantel)
        {
            isUpdatingPlantel = true;
            await InvokeAsync(StateHasChanged);
            var destino = await updatePlantel(forzarCreacion: true);
            Plantelseleccionado = destino;                         // reflejar en UI

            // Forzar asociación del RESULTADO al NUEVO plantel
            oResin1.Nropla = destino.Placod;
            await _resin1Servicio.Editar(oResin1);

            // Esperar a que el backend refleje el cambio
            await EsperarActualizacionNropla(Id, destino.Placod);

            // Refrescar entidad y UI
            var actualizado = await _resin1Servicio.LimitadosFiltradosNoInclude(0, 1, $"Id = {Id}");
            oResin1 = actualizado.List.FirstOrDefault() ?? oResin1;
            Plantelseleccionado = Planteles.FirstOrDefault(x => x.Placod == oResin1.Nropla) ?? Plantelseleccionado;

            isUpdatingPlantel = false;
            await InvokeAsync(StateHasChanged);
        }

        // 6) Refrescar grilla de resultados
        var rtRes = await _resin1Servicio.LimitadosFiltradosNoInclude(0, 0);
        resultados = rtRes.List;
        RefreshDerivedLists();

        ok = true;

        // 7) Render final
        await InvokeAsync(StateHasChanged);
    }
    catch (Exception ex)
    {
        Console.WriteLine(ex.Message);
        await Swal.FireAsync("Error", $"Ocurrió un error al crear el resultado sin solicitud: {ex.Message}", SweetAlertIcon.Error);
        loadingMovs = loadingHemyma = loadingProms = loadingRech = false;
        isSavingReporte = false;
        await InvokeAsync(StateHasChanged);
    }
    finally
    {
        // Si no se llego a crear nada, el tilde queda disponible para el proximo intento.
        if (!ok)
        {
            createNewPlantel = debeCrearPlantel;
        }

        isSavingReporte = false;
        isUpdatingPlantel = false;
    }

    return ok;
}




