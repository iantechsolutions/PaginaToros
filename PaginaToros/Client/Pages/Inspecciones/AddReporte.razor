    /// <summary>
    /// Unico punto de entrada del guardado. Decide solo si el reporte nace de una solicitud o no, y
    /// cuando termina bien vuelve al listado. Antes habia dos botones y el de alta dejaba al usuario
    /// en la misma pantalla con el boton cambiado a "Actualizar datos": eso invitaba a apretarlo de
    /// nuevo y cada click extra generaba otro resultado y otro plantel.
    /// </summary>
    async Task GuardarYVolver()
    {
        if (guardando)
        {
            return;
        }

        guardando = true;
        await InvokeAsync(StateHasChanged);

        var esAlta = Id == 0;
        try
        {
            var ok = (Id != 0 || TieneSolicitudSeleccionada)
                ? await confirmarNuevo()
                : await ResultWithoutSolicitud();

            if (!ok)
            {
                return;
            }

            await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = esAlta ? "Reporte generado" : "Reporte actualizado",
                    Icon = SweetAlertIcon.Success,
                    Timer = 1500,
                    ShowConfirmButton = false
                });

            NavigationManager.NavigateTo("/reportes");
        }
        finally
        {
            guardando = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task<bool> confirmar()
    {
        isSavingReporte = true;
        confirmado = true;
        // El tilde se consume de forma sincronica: cuando se apagaba recien despues de los awaits,
        // una segunda pasada por el circuito entraba con el tilde todavia prendido y forzaba la
        // creacion de otro plantel para el mismo socio y año.
        var debeCrearPlantel = createNewPlantel;
        createNewPlantel = false;
        var ok = false;
        loadingMovs = loadingHemyma = loadingProms = loadingRech = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            // Asegurar plantel seleccionado por las dudas
            if (Plantelseleccionado == null)
            {
                try
                {
                    Plantelseleccionado = Planteles
                        .Where(x => x.Nrocri == socioSeleccionado?.Scod)
                        .OrderByDescending(x => int.TryParse(x.Anioex, out var a) ? a : -1)
                        .FirstOrDefault();
                }
                catch
                {
                    Console.WriteLine("No se pudo resolver Plantelseleccionado.");
                }
            }

            var guardado = await guardarReporte();
            if (guardado == null)
            {
                return false;
            }

            var nrores = guardado.Nrores ?? solicitudSeleccionada?.FirstOrDefault()?.Nrosol;

            if (!string.IsNullOrWhiteSpace(nrores))
            {
                await LoadReportSectionsAsync(nrores);
                if (debeCrearPlantel)
                {
                    isUpdatingPlantel = true;
                    await InvokeAsync(StateHasChanged);
                    var destino = await updatePlantel(forzarCreacion: true);
                    oResin1.Nropla = destino.Placod;
                    await _resin1Servicio.Editar(oResin1);
                    await EsperarActualizacionNropla(Id, destino.Placod);

                    var actualizado = await _resin1Servicio.LimitadosFiltradosNoInclude(0, 1, $"Id = {Id}");
                    oResin1 = actualizado.List.FirstOrDefault() ?? oResin1;
                    Plantelseleccionado = Planteles.FirstOrDefault(x => x.Placod == oResin1.Nropla) ?? Plantelseleccionado;
                    await InvokeAsync(StateHasChanged);
                }


                var rtRes = await _resin1Servicio.LimitadosFiltradosNoInclude(0, 0);
                resultados = rtRes.List;
                RefreshDerivedLists();
            }

            ok = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            await Swal.FireAsync("Error", $"Ocurrió un error al guardar el reporte: {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            // Si el guardado no llego a buen puerto, el tilde vuelve a quedar disponible.
            if (!ok)
            {
                createNewPlantel = debeCrearPlantel;
            }

            isSavingReporte = false;
            isUpdatingPlantel = false;
            loadingMovs = loadingHemyma = loadingProms = loadingRech = false;
            await InvokeAsync(StateHasChanged);
        }

        return ok;
    }
 
