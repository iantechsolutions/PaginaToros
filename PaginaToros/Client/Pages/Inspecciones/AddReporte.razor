                                                    {
                                                        <td />
                                                    }
                                                    else
                                                    {
                                                        <td style="background-color: #fff;"><button class="btn" title="Ver info" @onclick='() => (agregarHembraMacho("scp"))'><FeatherEdit Color="green" /></button></td>
                                                    }
                                                
                                                </tr>
                                                <!-- C.P. -->
                                                <tr>
                                                    <td><strong>C.P.</strong></td>
                                                    <td>@hemyma.Msp</td>
                                                    <td>@hemyma.MspM</td>
                                                    <td>@hemyma.MspAs</td>
                                                    <td>@(hemyma.MspM + hemyma.MspAs)</td>
                                                    <td style="background-color: #666666;">@(hemyma.Msp - hemyma.MspM - hemyma.MspAs)</td>
                                                    <td>@hemyma.Mspsb</td>
                                                    @if (esSocio)
                                                    {
                                                        <td />
                                                    }
                                                    else
                                                    {
                                                            <td style="background-color: #fff;"><button disabled="@esSocio" class="btn" title="Ver info" @onclick='() => (agregarHembraMacho("cp"))'><FeatherEdit Color="green" /></button></td>
                                                        }
                                                </tr>
                                                    <tr style="background-color: #FF9966;">
                                                        <td><strong>TOTALES</strong></td>
                                                        <td>@(hemyma.Mcp + hemyma.Msp)</td>
                                                        <td>@(hemyma.McpM + hemyma.MspM)</td>
                                                        <td>@(hemyma.McpAs + hemyma.MspAs)</td>
                                                        <td>@(hemyma.MspM + hemyma.MspAs + hemyma.McpM + hemyma.McpAs)</td>
                                                        <td>@((hemyma.Msp - hemyma.MspM - hemyma.MspAs) + (hemyma.Mcp - hemyma.McpM - hemyma.McpAs))</td>
                                                        <td>@hemyma.Mspsb</td>
                                                        <td style="background-color: #fff;"></td>
                                                    </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            }
                        </RadzenTabsItem>
                        <RadzenTabsItem Text="Informe general">
                            @InformeGeneralContent
                        </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>

            }
        }
    </div>
}
@code {

    [CascadingParameter] public IModalService Modal { get; set; } = default!;

    bool tempReinspeccion = false;
    bool createNewPlantel = false;

    List<SocioDTO> socios = new();
    SocioDTO? socioSeleccionado = null;

    List<Resin8DTO> rechazos = new();
    List<Resin3DTO> mtos = new();
    Resin6DTO hemyma = new();

    Resin4DTO promediohembra = new();
    Resin4DTO promediomacho = new();

    List<InspectDTO> Inspects = new();
    InspectDTO? inspectorSeleccionado = null;

    List<Resin1DTO> resultados = new();
    List<EstableDTO> establecimientos = new();

    List<PlantelDTO> Planteles = new();
    PlantelDTO? Plantelseleccionado = null;
    bool primerMov = true;
    EstableDTO? establecimientoSeleccionado = null;
    List<Resin4DTO> promedios = new();
    List<Solici1DTO> solicitudes = new();
    List<Solici1DTO> solicitudesVisibles = new();
    Dictionary<string, EstableDTO> establecimientosPorCodigo = new(StringComparer.OrdinalIgnoreCase);
    IList<Solici1DTO?> solicitudSeleccionada = null;
    bool confirmado = false;
    bool isInitialLoading = true;
    bool isLoadingDependencias = false;
    bool isSavingReporte = false;
    bool isUpdatingPlantel = false;
    // Guard sincronico del guardado: el atributo disabled recien llega al DOM despues del re-render,
    // asi que un doble click rapido entraba dos veces al circuito y duplicaba resultado y plantel.
    bool guardando = false;
    bool procesandoMovimiento = false;
    // Plantel que creo el tilde "Crear nuevo plantel" en esta pantalla. Si el circuito vuelve a pasar
    // por updatePlantel se reutiliza, en vez de crear otro con codigo alternativo.
    PlantelDTO? plantelCreadoEnPantalla = null;
    string loadingMessage = "Preparando formulario de inspección...";
    Resin1DTO? oResin1 = new();
    DateTime fechaTemp = DateTime.Now;
    Respuesta<Resin1DTO> oRespuesta = new();
    Resin2DTO estadoAnterior = new();
    Resin2DTO salidasFinal = new();
    Resin2DTO entradasFinal = new();
    Resin2DTO estadoFinal = new();
    [CascadingParameter] BlazoredModalInstance ModalInstance { get; set; }
    [Parameter] public int Id { get; set; }
    bool esSocio { get; set; }
    [Parameter] public int opcion { get; set; }
    Dictionary<string, string> traductor = new Dictionary<string, string>{
        {"CO","Compras"},
        {"VE","Ventas"},
        {"CC","Cambio Categoria"},
        {"PI","Por Inspeccion"},
        {"EP","Epidemias"},
        {"RE","Rechazos"},
        {"RI","Reinspeccion"},
        {"AJ","Ajuste"},
        {"OT","Otros"},
        {"E","Entrada"},
        {"S","Salida"},
        {"1","Pelaje"},
        {"2","Estado"},
        {"3","Desarrollo"},
        {"4","Aplomo"},
        {"5","Estructura"},
        {"6","Conformacion"},
        {"7","Pureza"},
        {"8","Sanidad"},
        {"9","Otros"},
        {"10","Compras"},
        {"11","Ventas"},
        {"12","Cambio Categoria"},
        {"13","Por Inspeccion"},
        {"14","Epidemias"},
        {"15","Rechazos"},
        {"16","Otros"},
        {"17","Reinspeccion"},
        {"18","Ajuste"}
    };

    bool activo = true;
    bool loadingSolicitudes, loadingMovs, loadingHemyma, loadingProms, loadingRech;

    // El trabajo que dispara una seleccion de typeahead corre fuera del handler: si no,
    // el desplegable queda abierto hasta que termina y el usuario cree que el click fallo.
    private readonly SeleccionTypeahead _seleccionSocio = new();
    private readonly SeleccionTypeahead _seleccionPlantel = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    async Task CargarDatos()
    {
        try
        {
            isInitialLoading = true;
            loadingMessage = Id != 0 ? "Cargando reporte y datos asociados..." : "Preparando formulario de inspección...";
            await InvokeAsync(StateHasChanged);
            await Task.Yield();

            var inspectTask = _inspectServicio.LimitadosFiltrados(0, 0);
            var plantelTask = _plantelServicio.LimitadosFiltradosNoInclude(0, 0);

            var sociosTask = Id == 0
                ? _socioServicio.LimitadosFiltrados(0, 0)
                : Task.FromResult(new Respuesta<List<SocioDTO>> { List = new List<SocioDTO>() });
            var solicitudesTask = Id == 0
                ? _solici1Servicio.LimitadosFiltradosNoInclude(0, 0)
                : Task.FromResult(new Respuesta<List<Solici1DTO>> { List = new List<Solici1DTO>() });
            var resultadosTask = Id == 0
                ? _resin1Servicio.LimitadosFiltradosNoInclude(0, 0)
                : Task.FromResult(new Respuesta<List<Resin1DTO>> { List = new List<Resin1DTO>() });
            var establecimientosTask = _estableServicio.LimitadosFiltradosNoInclude(0, 0);

            esSocio = opcion == 1;

            if (Id != 0)
            {
                isLoadingDependencias = true;
                loadingMessage = "Cargando dependencias del reporte...";
                await InvokeAsync(StateHasChanged);
                await Task.Yield();

                string filtro = $"Id = {Id}";
                var res = await _resin1Servicio.LimitadosFiltradosNoInclude(0, 1, filtro);
                oResin1 = res.List.FirstOrDefault() ?? new Resin1DTO();

                // Igualdad exacta (no Contains): con Contains + limite 1, si el codigo de socio buscado
                // es subcadena de otro (ej. "5" dentro de "15"), el registro devuelto podia ser el de
                // OTRO socio y quedaba descartado por el filtro de abajo, mostrando el socio vacio.
                var socioFiltro = $"(Scod == null ? \"\" : Scod).Trim().ToUpper() == \"{EscapeForFilter(oResin1.Scod).Trim().ToUpper()}\"";
                var rt = await _socioServicio.LimitadosFiltrados(0, 1, socioFiltro);
                socioSeleccionado = rt.List.FirstOrDefault(x => x.Scod == oResin1.Scod) ?? new SocioDTO();

                if (!string.IsNullOrWhiteSpace(oResin1.Nrores))
                {
                    solicitudSeleccionada = new List<Solici1DTO?>
                    {
                        new Solici1DTO
                        {
                            Nrosol = oResin1.Nrores,
                            Codest = oResin1.Estcod,
                            Fecsol = oResin1.Freali
                        }
                    };
                }

                inspectorSeleccionado = null;
                Plantelseleccionado = null;
                establecimientoSeleccionado = null;
            }
            else
            {
                var sociosResponse = await sociosTask;
                socios = OrderSociosByCreation(sociosResponse.List);

                var solicitudesResponse = await solicitudesTask;
                solicitudes = OrderSolicitudesByCreation(solicitudesResponse.List);

                var resultadosResponse = await resultadosTask;
                resultados = OrderResultadosByCreation(resultadosResponse.List);
            }

            var inspectResponse = await inspectTask;
            Inspects = OrderInspectsByCreation(inspectResponse.List);

            var plantelResponse = await plantelTask;
            Planteles = OrderPlantelesByYear(plantelResponse.List);

            var establecimientosResponse = await establecimientosTask;
            establecimientos = establecimientosResponse.List ?? new List<EstableDTO>();
            establecimientosPorCodigo = establecimientos
                .Where(x => !string.IsNullOrWhiteSpace(x.Ecod))
                .GroupBy(x => x.Ecod!, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(x => x.Key, x => x.First(), StringComparer.OrdinalIgnoreCase);

            if (Id != 0)
            {
                var establecimiento = GetEstablecimientoForCurrentReport();
                establecimientoSeleccionado = establecimiento;

                if (socioSeleccionado != null)
                {
                    LoadSocioDerivedState(false);
                    var nrores = oResin1?.Nrores;
                    if (!string.IsNullOrWhiteSpace(nrores))
                    {
                        await LoadReportSectionsAsync(nrores, firstLoad: true);
                    }
                }

                Plantelseleccionado = Planteles.FirstOrDefault(x => x.Placod == oResin1.Nropla);
                if (Plantelseleccionado == null && oResin1?.Freali.HasValue == true)
                {
                    var anio = oResin1.Freali.Value.Year.ToString();
                    Plantelseleccionado = Planteles.FirstOrDefault(x => x.Anioex == anio && x.Nrocri == socioSeleccionado?.Scod);
                }
            }
            else
            {
                RefreshDerivedLists();
            }

            confirmado = Id != 0;
        }
        catch (Exception ex)
        {
            oRespuesta.Mensaje = ex.Message;
        }
        finally
        {
            isLoadingDependencias = false;
            isInitialLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string EscapeForFilter(string? value) => (value ?? string.Empty).Replace("\"", "\\\"");

    private void LoadSocioDerivedState(bool resetSelections)
    {
        if (resetSelections)
        {
            solicitudSeleccionada = null;
            Plantelseleccionado = null;
            establecimientoSeleccionado = null;
        }

        RefreshDerivedLists();
    }

    private void RefreshDerivedLists()
    {
        var codigosSocio = socioSeleccionado?.Scod == null
            ? new HashSet<string>(StringComparer.OrdinalIgnoreCase)
            : establecimientos
                .Where(x => string.Equals(x.Codsoc, socioSeleccionado.Scod, StringComparison.OrdinalIgnoreCase))
                .Select(x => x.Ecod)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var resultadosNrores = resultados
            .Where(x => !string.IsNullOrWhiteSpace(x.Nrores))
            .Select(x => x.Nrores!)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        solicitudesVisibles = solicitudes
            .Where(x => !string.IsNullOrWhiteSpace(x.Codest))
            .Where(x => codigosSocio.Contains(x.Codest!))
            .Where(x => string.IsNullOrWhiteSpace(x.Nrosol) || !resultadosNrores.Contains(x.Nrosol))
            .ToList();
    }

    private async Task LoadReportSectionsAsync(string nrores, bool firstLoad = false)
    {
        if (string.IsNullOrWhiteSpace(nrores))
        {
            return;
        }

        loadingMovs = loadingHemyma = loadingProms = loadingRech = true;
        if (!firstLoad)
        {
            await InvokeAsync(StateHasChanged);
        }

        try
        {
            await updateEstadoHistorico(nrores);
            await Task.WhenAll(
                updatePromedios(nrores),
                updateRechazos(nrores),
                updateHembrasMachos(nrores)
            );
            await updateMovimientos(nrores, "no");
        }
        finally
        {
            loadingMovs = loadingHemyma = loadingProms = loadingRech = false;
        }
    }

    private Task OnSocioChanged(SocioDTO? socio)
    {
        // Parte sincronica: el typeahead cierra el desplegable y pinta el socio al instante.
        socioSeleccionado = socio;
        isLoadingDependencias = true;
        loadingMessage = socio != null ? "Cargando datos del socio seleccionado..." : "Limpiando selección...";

        _seleccionSocio.Ejecutar(() => AplicarSocioSeleccionadoAsync(socio),
                                 () => InvokeAsync(StateHasChanged),
                                 nameof(OnSocioChanged));
        return Task.CompletedTask;
    }

    private Task AplicarSocioSeleccionadoAsync(SocioDTO? socio)
    {
        try
        {
            if (socio == null)
            {
                solicitudSeleccionada = null;
                Plantelseleccionado = null;
                establecimientoSeleccionado = null;
                inspectorSeleccionado = null;
                confirmado = false;
                oResin1 = new Resin1DTO();
                mtos = new();
                entradasFinal = new();
                salidasFinal = new();
                AplicarEstadoDesdePlantel(null);
                RefreshDerivedLists();
            }
            else
            {
                if (Id == 0)
                {
                    solicitudSeleccionada = null;
                    oResin1 = new Resin1DTO
                    {
                        Freali = fechaTemp,
                        Scod = socio.Scod
                    };
                    establecimientoSeleccionado = establecimientos.FirstOrDefault(x => string.Equals(x.Codsoc, socio.Scod, StringComparison.OrdinalIgnoreCase));
                    Plantelseleccionado = ElegirPlantelPorDefecto(socio.Scod);
                    inspectorSeleccionado = null;
                    confirmado = true;
                    // Existencia anterior visible ya mismo, sin esperar a confirmar.
                    mtos = new();
                    entradasFinal = new();
                    salidasFinal = new();
                    AplicarEstadoDesdePlantel(null);
                }

                RefreshDerivedLists();
            }
        }
        finally
        {
            isLoadingDependencias = false;
        }

        return Task.CompletedTask;
    }

    private Task OnPlantelChanged(PlantelDTO? plantel)
    {
        Plantelseleccionado = plantel;
        _seleccionPlantel.Ejecutar(PreviewPlantelAsync,
                                   () => InvokeAsync(StateHasChanged),
                                   nameof(OnPlantelChanged));
        return Task.CompletedTask;
    }

    /// <summary>
    /// Refleja en la grilla de movimientos el plantel elegido ANTES de confirmar, sin
    /// persistir nada: son los mismos campos que despues copia <see cref="crearHistorico"/>,
    /// asi que lo que se ve es lo que va a quedar grabado como existencia anterior.
    /// </summary>
    private async Task PreviewPlantelAsync()
    {
        if (Id != 0)
        {
            // El reporte ya existe: la existencia anterior la manda el historico guardado.
            return;
        }

        var nrores = solicitudSeleccionada?.FirstOrDefault()?.Nrosol;
        AplicarEstadoDesdePlantel(nrores);

        if (string.IsNullOrWhiteSpace(nrores))
        {
            mtos = new();
            entradasFinal = new();
            salidasFinal = new();
            RecalcularEstadoFinal();
            return;
        }

        await updateMovimientos(nrores, "no");
    }

    private PlantelDTO? ElegirPlantelPorDefecto(string? scod)
    {
        if (string.IsNullOrWhiteSpace(scod))
        {
            return null;
        }

        // Planteles ya viene ordenado por año descendente, asi que el First() es el mas reciente.
        var delSocio = Planteles.Where(x => MismoCodigo(x.Nrocri, scod)).ToList();
        if (delSocio.Count == 0)
        {
            return null;
        }

        var anio = GetInspectionYear().ToString();
        return delSocio.FirstOrDefault(x => string.Equals((x.Anioex ?? "").Trim(), anio, StringComparison.Ordinal))
               ?? delSocio.First();
    }

    private void AplicarEstadoDesdePlantel(string? nrores)
    {
        estadoAnterior = EstadoDesdePlantel(Plantelseleccionado, nrores);
        RecalcularEstadoFinal();
    }

    private static Resin2DTO EstadoDesdePlantel(PlantelDTO? plantel, string? nrores)
        => new Resin2DTO
            {
                Ea1 = Convert.ToInt32(plantel?.Varede ?? 0),
                Ea2 = Convert.ToInt32(plantel?.Vqcsrd ?? 0),
                Ea3 = Convert.ToInt32(plantel?.Vqssrd ?? 0),
                Ea4 = Convert.ToInt32(plantel?.Varepr ?? 0),
                Ea5 = Convert.ToInt32(plantel?.Vqcsrp ?? 0),
                Ea6 = Convert.ToInt32(plantel?.Vqssrp ?? 0),
                Nrores = nrores
            };

    private void RecalcularEstadoFinal()
    {
        estadoFinal.Ea1 = estadoAnterior.Ea1 - salidasFinal.Ea1 + entradasFinal.Ea1;
        estadoFinal.Ea2 = estadoAnterior.Ea2 - salidasFinal.Ea2 + entradasFinal.Ea2;
        estadoFinal.Ea3 = estadoAnterior.Ea3 - salidasFinal.Ea3 + entradasFinal.Ea3;
        estadoFinal.Ea4 = estadoAnterior.Ea4 - salidasFinal.Ea4 + entradasFinal.Ea4;
        estadoFinal.Ea5 = estadoAnterior.Ea5 - salidasFinal.Ea5 + entradasFinal.Ea5;
        estadoFinal.Ea6 = estadoAnterior.Ea6 - salidasFinal.Ea6 + entradasFinal.Ea6;
    }

    // Los codigos legacy (SCOD / NROCRI) vienen con padding y en mayusculas segun el registro.
    private static bool MismoCodigo(string? a, string? b)
        => string.Equals((a ?? string.Empty).Trim(), (b ?? string.Empty).Trim(), StringComparison.OrdinalIgnoreCase);

    private Solici1DTO? SelectedSolicitud => solicitudSeleccionada?.FirstOrDefault();

    private string? SelectedLocalidad
    {
        get
        {
            var codest = SelectedSolicitud?.Codest;
            if (string.IsNullOrWhiteSpace(codest))
            {
                return establecimientoSeleccionado?.Locali;
            }

            if (establecimientoSeleccionado != null && string.Equals(establecimientoSeleccionado.Ecod, codest, StringComparison.OrdinalIgnoreCase))
            {
                return establecimientoSeleccionado.Locali;
            }

            return establecimientosPorCodigo.TryGetValue(codest, out var establecimiento)
                ? establecimiento.Locali
                : string.Empty;
        }
    }

    private EstableDTO? GetEstablecimientoForCurrentReport()
    {
        var codest = oResin1?.Estcod ?? SelectedSolicitud?.Codest;
        if (string.IsNullOrWhiteSpace(codest))
        {
            return null;
        }

        if (establecimientoSeleccionado != null && string.Equals(establecimientoSeleccionado.Ecod, codest, StringComparison.OrdinalIgnoreCase))
        {
            return establecimientoSeleccionado;
        }

        return establecimientosPorCodigo.TryGetValue(codest, out var establecimiento)
            ? establecimiento
            : establecimientos.FirstOrDefault(x => string.Equals(x.Ecod, codest, StringComparison.OrdinalIgnoreCase));
    }

    DateTime? GetSocioCreationDate(SocioDTO? socio)
    {
        if (socio == null)
        {
            return null;
        }

        return socio.Fecing ?? socio.FchUsu;
    }

    DateTime? GetSolicitudCreationDate(Solici1DTO? solicitud)
    {
        return solicitud?.FchUsu;
    }

    DateTime? GetInspectCreationDate(InspectDTO? inspect)
    {
        return inspect?.FchUsu;
    }

    DateTime? GetResinCreationDate(Resin1DTO? resin)
    {
        if (resin == null)
        {
            return null;
        }

        return resin.FchUsu ?? resin.Freali;
    }

    List<PlantelDTO> OrderPlantelesByYear(IEnumerable<PlantelDTO>? items)
        => (items ?? Enumerable.Empty<PlantelDTO>())
            .OrderByDescending(x => TryGetPlantelYear(x).HasValue)
            .ThenByDescending(x => TryGetPlantelYear(x))
            .ThenByDescending(x => x.Id)
            .ToList();

    private static int? TryGetPlantelYear(PlantelDTO? plantel)
    {
        if (plantel == null || string.IsNullOrWhiteSpace(plantel.Anioex))
        {
            return null;
        }

        return int.TryParse(plantel.Anioex, out var year) ? year : null;
    }

    List<SocioDTO> OrderSociosByCreation(IEnumerable<SocioDTO>? items)
        => (items ?? Enumerable.Empty<SocioDTO>())
            .OrderByDescending(x => GetSocioCreationDate(x).HasValue)
            .ThenByDescending(x => GetSocioCreationDate(x))
            .ThenByDescending(x => x.Id)
            .ToList();

    List<Solici1DTO> OrderSolicitudesByCreation(IEnumerable<Solici1DTO>? items)
        => (items ?? Enumerable.Empty<Solici1DTO>())
            .OrderByDescending(x => GetSolicitudCreationDate(x).HasValue)
            .ThenByDescending(x => GetSolicitudCreationDate(x))
            .ThenByDescending(x => x.Id)
            .ToList();

    List<InspectDTO> OrderInspectsByCreation(IEnumerable<InspectDTO>? items)
        => (items ?? Enumerable.Empty<InspectDTO>())
            .OrderByDescending(x => GetInspectCreationDate(x).HasValue)
            .ThenByDescending(x => GetInspectCreationDate(x))
            .ThenByDescending(x => x.Id)
            .ToList();

    List<Resin1DTO> OrderResultadosByCreation(IEnumerable<Resin1DTO>? items)
        => (items ?? Enumerable.Empty<Resin1DTO>())
            .OrderByDescending(x => GetResinCreationDate(x).HasValue)
            .ThenByDescending(x => GetResinCreationDate(x))
            .ThenByDescending(x => x.Id)
            .ToList();

    async Task<Resin1DTO?> guardarReporte()
    {
        Console.WriteLine("guardarReporte");

        try
        {
            oResin1.Id = Id;
            var nroresSolicitud = solicitudSeleccionada?.FirstOrDefault()?.Nrosol;

            if (socioSeleccionado == null)
            {
                await Swal.FireAsync("Error", "Debe seleccionar un socio.", SweetAlertIcon.Error);
                return null;
            }

            if (Id != 0 && string.IsNullOrWhiteSpace(oResin1.Nrores) && string.IsNullOrWhiteSpace(nroresSolicitud))
            {
                await Swal.FireAsync("Error", "Debe seleccionar o generar una solicitud válida.", SweetAlertIcon.Error);
                return null;
            }

            if (inspectorSeleccionado == null)
            {
                await Swal.FireAsync("Error", "Debe seleccionar un inspector.", SweetAlertIcon.Error);
                return null;
            }

            if (Plantelseleccionado == null)
            {
                await Swal.FireAsync("Error", "Debe seleccionar un plantel válido.", SweetAlertIcon.Error);
                return null;
            }

            oResin1.Icod = inspectorSeleccionado.Icod;
            oResin1.Scod = socioSeleccionado.Scod;

            var soli = solicitudSeleccionada.FirstOrDefault();
            if (!string.IsNullOrWhiteSpace(soli?.Codest))
            {
                try
                {
                    oResin1.Estcod = soli.Codest;
                }
                catch (Exception ex)
                {
                    Console.WriteLine("Error al asignar Estcod: " + ex.Message);
                }
            }

            if (Id == 0)
            {
                oResin1.Nropla = Plantelseleccionado.Placod;
                oResin1.Freali = fechaTemp;
                if (string.IsNullOrWhiteSpace(oResin1.Nrores) && !string.IsNullOrWhiteSpace(nroresSolicitud))
                {
                    oResin1.Nrores = nroresSolicitud;
                }

                var result = await _resin1Servicio.Crear(oResin1);

                if (result?.List == null)
                {
                    await Swal.FireAsync("Error", "La respuesta del servidor al crear el reporte fue inválida.", SweetAlertIcon.Error);
                    return null;
                }

                oResin1 = result.List;
                Id = oResin1.Id;
                return oResin1;
            }
            else
            {
                if (string.IsNullOrWhiteSpace(oResin1.Nrores) && !string.IsNullOrWhiteSpace(nroresSolicitud))
                {
                    oResin1.Nrores = nroresSolicitud;
                }

                await _resin1Servicio.Editar(oResin1);

                var actualizado = await _resin1Servicio.LimitadosFiltradosNoInclude(0, 1, $"Id = {Id}");
                oResin1 = actualizado.List.FirstOrDefault() ?? oResin1;
                Plantelseleccionado = Planteles.FirstOrDefault(x => x.Placod == oResin1.Nropla) ?? Plantelseleccionado;
                await InvokeAsync(StateHasChanged);
                return oResin1;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Excepción al guardar reporte: " + ex.Message);
            await Swal.FireAsync("Error", "Ocurrió un error al guardar el reporte: " + ex.Message, SweetAlertIcon.Error);
            return null;
        }
    }


