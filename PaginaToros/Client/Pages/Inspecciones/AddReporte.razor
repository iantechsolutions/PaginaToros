            Plantelseleccionado = Planteles.FirstOrDefault(x => x.Placod == oResin1.Nropla) ?? Plantelseleccionado;
            await InvokeAsync(StateHasChanged);
                createNewPlantel = false; // <- clave para no seguir saltando a 2026, 2027, ...
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            await Swal.FireAsync("Error", $"Ocurrió un error al agregar/editar el movimiento: {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            procesandoMovimiento = false;
        }
    }



async Task<PlantelDTO> updatePlantel(bool forzarCreacion)
 {
    if (socioSeleccionado is null)
        throw new InvalidOperationException("No hay socio seleccionado.");

    var socio = socioSeleccionado!;
    var inspectionYear = GetInspectionYear();
    var anioDestino = inspectionYear.ToString();

    // Refrescar listado de planteles
    var plan = await _plantelServicio.LimitadosFiltradosNoInclude(0, 0);
    Planteles = plan.List;

    PlantelDTO? planDestino = null;
    var crearNuevo = forzarCreacion;

    if (forzarCreacion && plantelCreadoEnPantalla != null)
    {
        // El tilde "Crear nuevo plantel" ya creo uno en esta pantalla: se actualiza ese mismo.
        // Sin esta rama, cada vuelta extra del circuito creaba otro plantel del mismo socio y año
        // con codigo alternativo (62711, 6I2711, 6I271, ...), porque el bucle anticolision de mas
        // abajo le inventaba un codigo libre en vez de reconocer el plantel recien creado.
        planDestino = Planteles.FirstOrDefault(x => x.Placod == plantelCreadoEnPantalla.Placod)
                      ?? plantelCreadoEnPantalla;
        crearNuevo = false;
    }
    else if (!forzarCreacion)
    {
        // 1) PRIORIDAD: plantel asociado al resultado
        if (!string.IsNullOrWhiteSpace(oResin1?.Nropla))
        {
            planDestino = Planteles.FirstOrDefault(x => x.Placod == oResin1.Nropla);
        }

        // 2) Si no se encontró, usar Año + Socio
        if (planDestino == null)
        {
            planDestino = Planteles.FirstOrDefault(x => x.Anioex == anioDestino && x.Nrocri == socio.Scod);
        }

        crearNuevo = planDestino == null;
    }

    var ultimoDigito = anioDestino.Last();
    var fechaCreacionPlantel = (oResin1?.Freali ?? fechaTemp).ToString("yyyy/MM/dd");
    var fechaAltaPlantel = DateTime.Now.ToString("yyyy/MM/dd");

    if (!crearNuevo && planDestino != null)
    {
        // Actualizar plantel existente (solo si no se forza creación)
        VolcarEstadoFinalEn(planDestino, fechaCreacionPlantel);
        await _plantelServicio.Editar(planDestino);
    }
    else
    {
        // Forzar creación de uno nuevo o no se encontró
        var planViejo = Plantelseleccionado ?? Planteles.FirstOrDefault(x => x.Nrocri == socio.Scod) ?? throw new InvalidOperationException("No hay plantel base.");
        var tailAnterior = DerivarTailCodigo(planViejo.Placod);
        if (string.IsNullOrWhiteSpace(tailAnterior))
            tailAnterior = DerivarTailCodigo(socio.Placod);
        if (string.IsNullOrWhiteSpace(tailAnterior))
            tailAnterior = planViejo.Placod?.Trim() ?? socio.Placod?.Trim() ?? "";

        var nuevoPlacod = $"{ultimoDigito}{tailAnterior}";

        // Si ese codigo YA es un plantel del mismo socio y del mismo año, no es una colision: es el
        // plantel que este mismo circuito creo en una vuelta anterior (o en otra sesion). Se
        // actualiza en vez de inventarle un codigo libre.
        //
        // Esta es la raiz de la cascada que se vio en produccion: el bucle anticolision de abajo le
        // daba un codigo alternativo, ese pasaba a ser Plantelseleccionado, y en la vuelta siguiente
        // DerivarTailCodigo lo recortaba distinto y generaba OTRO codigo libre. Asi salian cadenas
        // como 5RJ01 -> 6RJ01 -> 6RJ011 -> 6J011 -> 6J0111 -> 60111, un plantel por vuelta.
        var propioDelAnio = Planteles.FirstOrDefault(p =>
            string.Equals((p.Placod ?? "").Trim(), nuevoPlacod, StringComparison.OrdinalIgnoreCase)
            && MismoCodigo(p.Nrocri, socio.Scod)
            && string.Equals((p.Anioex ?? "").Trim(), anioDestino, StringComparison.Ordinal));

        if (propioDelAnio != null)
        {
            VolcarEstadoFinalEn(propioDelAnio, fechaCreacionPlantel);
            await _plantelServicio.Editar(propioDelAnio);

            if (forzarCreacion)
            {
                plantelCreadoEnPantalla = propioDelAnio;
            }

            Plantelseleccionado = propioDelAnio;
            return propioDelAnio;
        }

        // El bucle anticolision queda solo para choques con planteles de OTRO socio u OTRO año.
        var candidate = nuevoPlacod;
        int suffix = 1;
        while (Planteles.Any(p => p.Placod == candidate))
        {
            candidate = nuevoPlacod + suffix.ToString();
            suffix++;
        }

