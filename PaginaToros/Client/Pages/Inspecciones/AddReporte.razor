    /// <summary>
    /// Deja grabada la existencia anterior del reporte. Es idempotente: si ya hay un Resin2 para ese
    /// nrores se reutiliza, porque antes cada guardado creaba otro historico y el mismo numero de
    /// reporte terminaba con varias filas de existencia anterior.
    /// </summary>
    async Task crearHistorico(string nrores)
    {
        if (string.IsNullOrWhiteSpace(nrores))
        {
            return;
        }

        string filtro = $"(Nrores == null ? \"\" : Nrores).Trim().ToUpper() == \"{EscapeForFilter(nrores).Trim().ToUpper()}\"";
        var existentes = await _resin2Servicio.LimitadosFiltrados(0, 1, filtro);
        var existente = existentes.List
            .FirstOrDefault(x => string.Equals((x.Nrores ?? "").Trim(), nrores.Trim(), StringComparison.OrdinalIgnoreCase));

        if (existente != null)
        {
            estadoAnterior = existente;
            RecalcularEstadoFinal();
            return;
        }

        var temp = EstadoDesdePlantel(Plantelseleccionado, nrores);
        estadoAnterior = temp;
        RecalcularEstadoFinal();

        await _resin2Servicio.Crear(temp);
    }

