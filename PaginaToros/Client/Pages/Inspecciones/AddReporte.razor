            var options = new ModalOptions { Size = ModalSize.ExtraLarge };
            var formModal = Modal.Show<AddMovimientoRe>("Agregar Movimiento", parameters, options);
            var result = await formModal.Result;
            if (result.Cancelled) return;

            // Recalcular totales (estadoFinal)
            await updateMovimientos(nrores, "si");

            // Persistir en plantel: solo subir de año si todavía está tildado
        var destino = await updatePlantel(forzarCreacion: createNewPlantel);

            // Si acabo de crear/migrar, apunto el informe al NUEVO plantel y APAGO el flag
            if (createNewPlantel && !string.IsNullOrWhiteSpace(oResin1?.Nrores))
            {
                oResin1.Nropla = destino.Placod;
                await _resin1Servicio.Editar(oResin1);

                await EsperarActualizacionNropla(Id, destino.Placod);

            var actualizado = await _resin1Servicio.LimitadosFiltradosNoInclude(0, 1, $"Id = {Id}");
