    async Task updateEstadoHistorico(string nrores)
    {
        try
        {
            string filtro = $"(Nrores == null ? \"\" : Nrores).Trim().ToUpper() == \"{EscapeForFilter(nrores).Trim().ToUpper()}\"";
            var rt = await _resin2Servicio.LimitadosFiltrados(0, 1, filtro);

            // Igualdad exacta (no Contains): evita heredar el estado historico de OTRO reporte de inspeccion.
            var hist = rt.List.FirstOrDefault(x => string.Equals((x.Nrores ?? "").Trim(), nrores.Trim(), StringComparison.OrdinalIgnoreCase));
            if (hist != null)
            {
                estadoAnterior = hist;
            }
            else
            {
                // Fallback al plantel seleccionado
                if (Plantelseleccionado is null)
                {
                    // como último recurso, intentá recuperar el plantel del socio (ya lo hacés en otros lados)
                    var plan = await _plantelServicio.LimitadosFiltradosNoInclude(0, 0);
                    Planteles = OrderPlantelesByYear(plan.List);
                    Plantelseleccionado = Planteles
                        .Where(x => x.Nrocri == socioSeleccionado?.Scod)
                        .FirstOrDefault();
                }

                estadoAnterior = new Resin2DTO
                    {
                        Ea1 = Convert.ToInt32(Plantelseleccionado?.Varede ?? 0),
                        Ea2 = Convert.ToInt32(Plantelseleccionado?.Vqcsrd ?? 0),
                        Ea3 = Convert.ToInt32(Plantelseleccionado?.Vqssrd ?? 0),
                        Ea4 = Convert.ToInt32(Plantelseleccionado?.Varepr ?? 0),
                        Ea5 = Convert.ToInt32(Plantelseleccionado?.Vqcsrp ?? 0),
                        Ea6 = Convert.ToInt32(Plantelseleccionado?.Vqssrp ?? 0),
                        Nrores = nrores
                    };

                // Opcional pero recomendado: persistirlo para no recalcular cada vez
                await _resin2Servicio.Crear(estadoAnterior);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

