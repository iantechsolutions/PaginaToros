@code {

    [CascadingParameter] public IModalService Modal { get; set; } = default!;
    public RadzenDataGrid<PlantelDTO>? grid;
    int currentPage;
    bool isLoading = false;
    readonly SeleccionTypeahead seleccionSocio = new();
    bool updatingCreationDates = false;
    int cantidad;
    SocioDTO socioSeleccionado;
    public bool allowFiltering = false;
    List<SocioDTO> socios = new();
    public Respuesta<List<PlantelDTO>> oRespuesta = new Respuesta<List<PlantelDTO>>();
    bool esSocio;
    int loadRequestVersion;
    // Vista de socio: todos sus planteles en el orden por defecto del servidor (se ordenan en memoria).
    List<PlantelDTO> plantelesSocio = new();

    // Orden inicial: el de siempre (fecha de alta, más recientes primero). Los campos coinciden con la
    // Property de cada columna y con PlantelRepositorio.Sort*.
    ListSort sort = CrearOrden(incluirSocio: true);

    static ListSort CrearOrden(bool incluirSocio)
    {
        var campos = new List<SortField>
        {
            new("FechaAlta", "Fecha de alta", SortValueKind.Date),
            new("Placod", "Nro plantel", SortValueKind.Text),
            new("Estado", "Activo", SortValueKind.Text, "Inactivos primero", "Activos primero", FirstDescending: true),
            new("Anioex", "Año de existencia", SortValueKind.Date),
        };
        if (incluirSocio)
        {
            campos.Add(new("Socio.Nombre", "Socio", SortValueKind.Text));
        }

        campos.AddRange(new SortField[]
        {
            new("Varede", "Vacas PR", SortValueKind.Number),
            new("Vqcsrd", "Vaq. PR C/S", SortValueKind.Number),
            new("Vqssrd", "Vaq. PR S/S", SortValueKind.Number),
            new("Varepr", "Vacas VIP", SortValueKind.Number),
            new("Vqcsrp", "Vaq. VIP C/S o preñadas", SortValueKind.Number),
            new("Vqssrp", "Vaq. VIP S/S", SortValueKind.Number),
        });

        return new ListSort(campos, defaultKey: "FechaAlta", defaultDescending: true);
    }

    // Mismas claves que PlantelRepositorio.SortKeys, para la vista de socio (ordenada en el cliente).
    static readonly IReadOnlyDictionary<string, Func<PlantelDTO, object?>> ClavesOrden =
        new Dictionary<string, Func<PlantelDTO, object?>>
        {
            ["FechaAlta"] = x => PlantelFechaAlta.Obtener(x.Fecing, x.FchUsu),
            ["Placod"] = x => x.Placod,
            ["Estado"] = x => x.Estado,
            ["Anioex"] = x => InMemorySort.ParseYear(x.Anioex),
            ["Socio.Nombre"] = x => x.Socio?.Nombre,
            ["Varede"] = x => x.Varede,
            ["Vqcsrd"] = x => x.Vqcsrd,
            ["Vqssrd"] = x => x.Vqssrd,
            ["Varepr"] = x => x.Varepr,
            ["Vqcsrp"] = x => x.Vqcsrp,
            ["Vqssrp"] = x => x.Vqssrp,
        };

    protected override async Task OnInitializedAsync()
    {
        esSocio = await UserHasRole("Socio") || await UserHasRole("SOCIO");
        if (esSocio)
        {
            sort = CrearOrden(incluirSocio: false);
        }

        await Get();
    }

    async Task Get()
    {
        if (!esSocio)
        {
            var rta = await _socioServicio.LimitadosFiltrados(0, 0);
            socios = rta.List;
            await CargarPagina(0, 15, null);
        }
        else
        {
            var context = await Http.GetFromJsonAsync<UserContextDTO>("api/Account/context");
            var socioId = context?.ActiveSocioId ?? context?.AllowedSocios?.FirstOrDefault()?.Id ?? 0;
            var respuesta = await _plantelServicio.GetBySocioId(socioId);
            EnsureNoDuplicates(respuesta);
            LogDuplicatesIfAny(respuesta, "Get - GetBySocioId");
            plantelesSocio = respuesta.List ?? new List<PlantelDTO>();
            oRespuesta = new Respuesta<List<PlantelDTO>> { Exito = respuesta.Exito, Mensaje = respuesta.Mensaje, List = OrdenarPlantelesSocio() };
            cantidad = plantelesSocio.Count;
        }
    }

    // El orden por defecto es el que ya devuelve el servidor; el resto se ordena en memoria con las
    // mismas reglas (vacíos al final, empates por el último cargado).
    List<PlantelDTO> OrdenarPlantelesSocio()
        => sort.IsSortedBy("FechaAlta") && sort.Descending
            ? plantelesSocio.ToList()
            : sort.ApplyTo(plantelesSocio, ClavesOrden, x => x.Id);

    async Task OnSortChanged()
    {
        if (esSocio)
        {
            oRespuesta.List = OrdenarPlantelesSocio();
            if (grid != null)
            {
                await grid.FirstPage();
            }

            StateHasChanged();
            return;
        }

        await RecargarDesdeElPrincipio();
    }

    // Al cambiar el orden, el socio buscado o los filtros se vuelve a la primera página: seguir en la
    // página N de otro conjunto muestra registros sin relación con los que se estaban viendo.
    async Task RecargarDesdeElPrincipio()
    {
        if (grid == null)
        {
            return;
        }

        if (grid.CurrentPage > 0)
        {
            await grid.FirstPage(true);
        }
        else
        {
            await grid.Reload();
        }
    }

    // Recarga después de editar, eliminar o agregar, conservando la página.
    async Task Refrescar()
    {
        if (esSocio)
        {
            await Get();
            if (grid != null)
            {
                await grid.GoToPage(currentPage);
            }
        }
        else if (grid != null)
        {
            await grid.Reload();
        }
    }


    private async Task<bool> UserHasRole(string role)
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authenticationState.User.IsInRole(role);
    }
    public void CambiarModoFiltro()
    {
        allowFiltering = !allowFiltering;
        StateHasChanged();
    }

    async Task CompletarFechasCreacion()
    {
        if (updatingCreationDates)
        {
            return;
        }

        SweetAlertResult result = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "¿Completar fechas de creación?",
                Text = "Se intentará asignar una fecha de creación a los planteles que no la tengan, usando la primera fecha de inspección disponible.",
                Icon = SweetAlertIcon.Question,
                ShowCancelButton = true,
                ConfirmButtonText = "Actualizar",
                CancelButtonText = "Cancelar"
            });

        if (string.IsNullOrEmpty(result.Value))
        {
            return;
        }

        updatingCreationDates = true;
        StateHasChanged();

        try
        {
            var respuesta = await _plantelServicio.CompletarFechasCreacion();
            await Get();
            await Swal.FireAsync("Actualización completa", $"Se actualizaron {respuesta.List} planteles.", SweetAlertIcon.Success);
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", $"No se pudieron completar las fechas. {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            updatingCreationDates = false;
            StateHasChanged();
        }
    }

    async Task delete(int id)
    {
        currentPage = grid.CurrentPage;
        await _plantelServicio.Eliminar(id);
        await grid.Reload();
        if (currentPage >= grid.Count / grid.PageSize && grid.Count != 0)
        {
            await grid.GoToPage(currentPage - 1);
        }
        else if (grid.Count != 0)
        {
            await grid.GoToPage(currentPage);
        }

    }

    public async Task alertaDelete(int id)
    {
        SweetAlertResult result = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "¿Está seguro?",
                Text = "Se eliminará al plantel",
                Icon = SweetAlertIcon.Warning,
                ShowCancelButton = true,
                ConfirmButtonText = "Eliminar",
                CancelButtonText = "Cancelar"
            });

        if (!string.IsNullOrEmpty(result.Value))
        {
            delete(id);

        }
        else if (result.Dismiss == DismissReason.Cancel)
        {

        }
    }

    async Task add(int Id, bool esSocio)
    {
        int numero = Id;
        if (numero != 0)
        {
            currentPage = grid.CurrentPage;
            try
            {
                var parameters = new ModalParameters();
                parameters.Add(nameof(AddPlantele.Id), Id);
                parameters.Add(nameof(AddPlantele.esSocio), esSocio);
                var options = new ModalOptions()
                    {
                        Size = ModalSize.ExtraLarge,
                        DisableBackgroundCancel = true
                    };
                var formModal = Modal.Show<AddPlantele>("Editar Plantel", parameters, options);
                var result = await formModal.Result;
                if (result.Cancelled)
                {
                    Console.WriteLine("Modal was cancelled");
                    await grid.GoToPage(currentPage);
                }
                else
                {
                    await Refrescar();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
            }
        }
        else
        {
            var options = new ModalOptions()
                {
                    Size = ModalSize.ExtraLarge
                };
            var formModal = Modal.Show<AddPlantele>("Agregar Plantel", options);
            var result = await formModal.Result;

            if (result.Cancelled)
            {
                Console.WriteLine("Modal was cancelled");
                await grid.GoToPage(currentPage);
            }
            else
            {
                await Refrescar();
            }
        }
    }
    async Task gotoinfo(int id)
    {
        currentPage = grid.CurrentPage;
        var parameters = new ModalParameters();
        var options = new ModalOptions()
            {
                HideHeader = true,
                HideCloseButton = true,
                Size = ModalSize.ExtraLarge
            };
        parameters.Add(nameof(InfoPlantel.id), id);
        var formModal = Modal.Show<InfoPlantel>("", parameters, options);
        var result = await formModal.Result;

        if (result.Cancelled)
        {
            Console.WriteLine("Modal was cancelled");
            await grid.GoToPage(currentPage);
        }
        else
        {
            await Refrescar();
        }
    }
    private Task OnSocioSeleccionadoChanged(SocioDTO value)
    {
        socioSeleccionado = value;

        // La busqueda corre fuera del handler: si la esperamos aca, BlazoredTypeahead no
        // cierra el desplegable hasta que vuelve el request (ver SeleccionTypeahead).
        seleccionSocio.Ejecutar(BuscarPorSocio,
                                () => InvokeAsync(StateHasChanged),
                                nameof(OnSocioSeleccionadoChanged));
        return Task.CompletedTask;
    }

    // Grilla de administradores: paginada en el servidor, con el orden y el total del conjunto filtrado
    // (socio buscado + filtros de columna).
    Task LoadData(LoadDataArgs args)
        => CargarPagina(args.Skip ?? 0, args.Top ?? 15, args.Filter);

    async Task CargarPagina(int skip, int top, string? filtroGrilla)
    {
        var requestId = ++loadRequestVersion;
        isLoading = true;
        StateHasChanged();
        try
        {
            var respuesta = await _plantelServicio.SearchPaged(skip, top, ConstruirFiltro(filtroGrilla), sort.Key, sort.Descending);
            if (requestId != loadRequestVersion)
            {
                return;
            }

            oRespuesta = new Respuesta<List<PlantelDTO>>
            {
                Exito = respuesta.Exito,
                Mensaje = respuesta.Mensaje,
                List = respuesta.List?.Items ?? new List<PlantelDTO>()
            };
            cantidad = respuesta.List?.TotalCount ?? 0;
            LogDuplicatesIfAny(oRespuesta, $"CargarPagina skip={skip} top={top}");
        }
        catch (Exception ex)
        {
            if (requestId != loadRequestVersion)
            {
                return;
            }

            oRespuesta = new Respuesta<List<PlantelDTO>> { Exito = 0, List = new List<PlantelDTO>() };
            cantidad = 0;
            await Swal.FireAsync("Error", $"No se pudieron cargar los planteles. {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            if (requestId == loadRequestVersion)
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    string? ConstruirFiltro(string? filtroGrilla)
    {
        var filtroSocio = socioSeleccionado != null ? $"Socio.Id == {socioSeleccionado.Id}" : null;
        var hayFiltroGrilla = !string.IsNullOrWhiteSpace(filtroGrilla);

        if (filtroSocio == null)
        {
            return hayFiltroGrilla ? filtroGrilla : null;
        }

        return hayFiltroGrilla ? $"({filtroSocio}) && ({filtroGrilla})" : filtroSocio;
    }

    private Task<IEnumerable<SocioDTO>> BusquedaSocios(string searchText)
    {
        if (socios == null)
        {
            return Task.FromResult(Enumerable.Empty<SocioDTO>());
        }

        var texto = searchText ?? string.Empty;
        var result = socios
            .Where(x => !string.IsNullOrEmpty(x.Nombre)
                     && x.Nombre.Contains(texto, StringComparison.OrdinalIgnoreCase))
            .Take(20)
            .ToList();

        return Task.FromResult<IEnumerable<SocioDTO>>(result);
    }

    private Task BuscarPorSocio() => RecargarDesdeElPrincipio();

    void EnsureNoDuplicates(Respuesta<List<PlantelDTO>> respuesta)
    {
        if (respuesta == null || respuesta.List == null) return;

        respuesta.List = respuesta.List
            .GroupBy(p =>
            {
                // Prefer grouping by Placod + Anioex + Nrocri when available
                var placod = p.Placod ?? string.Empty;
                var anio = p.Anioex ?? string.Empty;
                var nrocri = p.Nrocri ?? string.Empty;
                var key = (placod + "|" + anio + "|" + nrocri).Trim();
                return string.IsNullOrEmpty(key) ? ("ID|" + p.Id.ToString()) : ("P|" + key);
            })
            .Select(g => g.First())
            .ToList();
    }

    void LogDuplicatesIfAny(Respuesta<List<PlantelDTO>> respuesta, string context)
    {
        if (respuesta == null || respuesta.List == null) return;
        var groups = respuesta.List.GroupBy(p => p.Id).Where(g => g.Count() > 1).ToList();
        if (!groups.Any()) return;
        Console.WriteLine($"[Diagnostics] Duplicates detected in {context}: {groups.Count} groups");
        foreach (var g in groups)
        {
            Console.WriteLine($"[Diagnostics] Id={g.Key} Count={g.Count()} Placods=[{string.Join(',', g.Select(x=>x.Placod))}]");
        }
    }

