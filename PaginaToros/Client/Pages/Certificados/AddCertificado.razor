@using Blazored.Typeahead
@using System.Globalization
@using System.Text
@using PaginaToros.Client.Servicios.Contrato;
@inject ICertifsemanServicio _certifsemanServicio
@inject ISocioServicio _socioServicio
@inject ICentrosiumServicio _centrosiumServicio
@inject HttpClient http




<style>
    .bm-title {
        font-size: 25px;
        font-weight: bold;
    }
</style>
@if (centros.Count>0){
<div class="card">
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(formMessage))
        {
            <div class="@formMessageCss" role="alert">
                @formMessage
            </div>
        }

        @if (validationErrors.Count > 0)
        {
            <div class="alert alert-danger" role="alert">
                <strong>Revisá estos datos:</strong>
                <ul class="mb-0 mt-2">
                    @foreach (var error in validationErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <EditForm Model="@oCertifseman" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />
            <div class="row" style="width=100%;">
                <div class="col-sm">
                    <label class="col-sm">Tipo</label>
                    <RadzenDropDown @bind-Value=@oCertifseman.TipoCert Data=@tipos Style="width: 100%; max-width: 400px;" />
                    <ValidationMessage For="(()=> oCertifseman.TipoCert)" style="color:red;" />
                </div>
                <div class="col-sm">
                    <label class="col-sm">Nro de certificado</label>
                    <InputText @bind-Value="@oCertifseman.NroCert" class="form-control" placeholder=""></InputText>
                    <ValidationMessage For="(()=> oCertifseman.NroCert)" style="color:red;" />
                </div>
                <div class="col-sm">
                    <label class="col-sm">Centro</label>
                    <BlazoredTypeahead SearchMethod="BusquedaCentros"
                                       placeholder="Buscar por nombre o nro. de centro"
                                       EnableDropDown="true"
                                       TItem="CentrosiumDTO"
                                       TValue="CentrosiumDTO"
                                       Value="centroSeleccionado"
                                       ValueChanged="OnCentroChanged"
                                       ValueExpression="@(() => centroSeleccionado)">
                        <SelectedTemplate Context="eleccion">
                            @DescribirCentro(eleccion)
                        </SelectedTemplate>
                        <ResultTemplate Context="eleccion">
                            @DescribirCentro(eleccion)
                        </ResultTemplate>
                    </BlazoredTypeahead>
                </div>
                    <div class="col-sm">
                        <label>Fecha de Venta</label><br />
                        <RadzenDatePicker TValue="DateTime?" @bind-Value="@oCertifseman.Fecvta" ShowTime="false" ShowSeconds="false" DateFormat="dd/MM/yyyy" Class="w-75" />
                        <button type="button" title="Eliminar" @onclick="() => oCertifseman.Fecvta=null"><FeatherXCircle Size="16" Color="red" /></button>
                    </div>
            </div>
            <br />
            <div class="row" style="width=100%;">
                <div class="col-sm">
                    <label class="col-sm">Socio</label>
                    <BlazoredTypeahead SearchMethod="BusquedaSocios"
                                       placeholder="Buscar por nombre o código"
                                       EnableDropDown="true"
                                       TItem="SocioDTO"
                                       TValue="SocioDTO"
                                       Value="socioSeleccionado"
                                       ValueChanged="OnSocioChanged"
                                       ValueExpression="@(() => socioSeleccionado)">
                        <SelectedTemplate Context="eleccion">
                            @eleccion.Nombre
                        </SelectedTemplate>
                        <ResultTemplate Context="eleccion">
                            @eleccion.Nombre
                        </ResultTemplate>
                    </BlazoredTypeahead>
                </div>
                <div class="col-sm">
                    <label class="col-sm">Tipo de envase</label>
                    <InputText @bind-Value="@oCertifseman.TipEnv" class="form-control" placeholder=""></InputText>
                    <ValidationMessage For="(()=> oCertifseman.TipEnv)" style="color:red;" />
                </div>
                <div class="col-sm">
                    <label class="col-sm">Cantidad original de dosis</label>
                    <InputText @bind-Value="@oCertifseman.NrDosiOr" class="form-control" placeholder="" inputmode="numeric"></InputText>
                    <ValidationMessage For="(()=> oCertifseman.NrDosiOr)" style="color:red;" />
                </div>
                <div class="col-sm">
                    <label class="col-sm">Cantidad de dosis remanentes</label>
                    <InputNumber @bind-Value="@oCertifseman.NrDosi" class="form-control" placeholder=""></InputNumber>
                    <ValidationMessage For="(()=> oCertifseman.NrDosi)" style="color:red;" />
                </div>
            </div>
            <br />
            <div class="row" style="width=100%;">
                <div class="col-sm">
                    <label class="col-sm">Tip/ADN</label>
                    <InputText @bind-Value="@oCertifseman.NrTsan" class="form-control" placeholder=""></InputText>
                    <ValidationMessage For="(()=> oCertifseman.NrTsan)" style="color:red;" />
                </div>
                <div class="col-sm">
                    <label class="col-sm">Macho Dador Nro</label>
                    <InputText @bind-Value="@oCertifseman.NrInsd" class="form-control" placeholder=""></InputText>
                    <ValidationMessage For="(()=> oCertifseman.NrInsd)" style="color:red;" />
                </div>
                <div class="col-sm">
                    <label class="col-sm">Variedad</label>
                    <RadzenDropDown @bind-Value=@oCertifseman.Variedad Data=@variedades Style="width: 100%; max-width: 400px;" />
                    <ValidationMessage For="(()=> oCertifseman.Variedad)" style="color:red;" />
                </div>
                    <div class="col-sm">
                        <label class="col-sm">Apodo</label>
                        <InputText @bind-Value="@oCertifseman.Apodacion" class="form-control" placeholder=""></InputText>
                        <ValidationMessage For="(()=> oCertifseman.Apodacion)" style="color:red;" />
                    </div>
            </div>
            <br />
            <div class="row" style="width=100%;">
                <div class="col-sm">
                    <label class="col-sm">Tipo de toro</label>
                        <RadzenDropDown @bind-Value=@oCertifseman.Apodo Data=@tiposToro Style="width: 100%; max-width: 400px;" />
                    <ValidationMessage For="(()=> oCertifseman.Apodo)" style="color:red;" />
                </div>
                @if (oCertifseman.Apodo == "S/")
                {
                    <div class="col-sm">
                        <label class="col-sm">HBA</label>
                        <InputText @bind-Value="@oCertifseman.Hba" class="form-control" placeholder=""></InputText>
                        <ValidationMessage For="(()=> oCertifseman.Hba)" style="color:red;" />
                    </div>
                    <div class="col-sm">
                        <label class="col-sm">Tatuaje</label>
                        <InputText @bind-Value="@oCertifseman.Tatpart" class="form-control" placeholder=""></InputText>
                        <ValidationMessage For="(()=> oCertifseman.Tatpart)" style="color:red;" />
                    </div>
                    <div class="col-sm">
                        <label class="col-sm">Nombre</label>
                        <InputText @bind-Value="@oCertifseman.NomDad" class="form-control" placeholder=""></InputText>
                        <ValidationMessage For="(()=> oCertifseman.NomDad)" style="color:red;" />
                    </div>
                }
                else
                {
                    <div class="col-sm">
                        <label class="col-sm">HBA</label>
                        <InputText @bind-Value="@oCertifseman.Hba" class="form-control" placeholder=""></InputText>
                        <ValidationMessage For="(()=> oCertifseman.Hba)" style="color:red;" />
                    </div>
                    <div class="col-sm">
                        <label class="col-sm">Tatuaje</label>
                        <InputText @bind-Value="@oCertifseman.Tatpart" class="form-control" placeholder=""></InputText>
                        <ValidationMessage For="(()=> oCertifseman.Tatpart)" style="color:red;" />
                    </div>
                    <div class="col-sm">
                        <label class="col-sm">Nombre</label>
                        <InputText @bind-Value="@oCertifseman.NomDad" class="form-control" placeholder=""></InputText>
                        <ValidationMessage For="(()=> oCertifseman.NomDad)" style="color:red;" />
                    </div>
                }
            </div>
            <br />

            @if (Id != 0)
            {
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="avisoEdicionMail" @bind="enviarAvisoPorMail" />
                    <label class="form-check-label" for="avisoEdicionMail">
                        Enviar aviso de edición de certificado por mail al socio
                    </label>
                    @if (enviarAvisoPorMail)
                    {
                        <div class="text-muted" style="font-size:13px;">@DescribirDestinatarioAviso()</div>
                    }
                </div>
            }

            <button type="submit" class="btn btn-primary mr-2" disabled="@isBusy">Aceptar</button>
            <button type="button" @onclick="cancel" class="btn btn-light" disabled="@isBusy">Cancelar</button>
        </EditForm>
    </div>
</div>
}
else
{
    <br />
    <center>
        <div class="mb-2">
            <br />
            <RadzenProgressBar style="position:relative;width:93.5%" Value="100" ShowValue="false" ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" />
        </div>
    </center>
}
@code {
    CertifsemanDTO oCertifseman = new();
    List<string> tipos = new List<string> {"Tercero","Propio","Importado"};
    List<string> variedades = new List<string> {"H","PH"};
    List<string> tiposToro = new List<string> {"S/","PP","GP"};

    SocioDTO? socioSeleccionado = null;
    List<SocioDTO> socios = new();
    CentrosiumDTO? centroSeleccionado = null;
    List<CentrosiumDTO> centros = new();
    // El typeahead no expone el texto tipeado al padre. Lo guardamos para poder
    // resolver la seleccion aunque el usuario no haya clickeado un item de la lista.
    private string? ultimaBusquedaCentro;
    private string? ultimaBusquedaSocio;
    private readonly List<string> validationErrors = new();
    private string? formMessage;
    private string formMessageCss = "alert alert-danger";
    private bool isBusy;
    // Copia del certificado tal como vino de la base. Sirve para dos cosas: no
    // exigirle al usuario datos que ya estaban vacíos y listar en el mail qué
    // cambió realmente.
    private CertifsemanDTO? estadoOriginal;
    // El aviso por mail es opcional y arranca apagado: editar un certificado no
    // deberia notificar al socio salvo que se lo pida explicitamente.
    private bool enviarAvisoPorMail;
    [CascadingParameter] BlazoredModalInstance ModalInstance { get; set; }
    [Parameter] public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var rta = await _socioServicio.LimitadosFiltrados(0, 0);
        socios = rta.List ?? new();
        var rt = await _centrosiumServicio.LimitadosFiltrados(0, 0);
        centros = rt.List ?? new();

        if (Id != 0)
        {
            try
            {
                string filtro = $"Id = {Id}";
                var rtt = await _certifsemanServicio.LimitadosFiltradosNoInclude(0, 1, filtro);
                oCertifseman = rtt.List?.FirstOrDefault() ?? new CertifsemanDTO();
                if (oCertifseman.Id == 0)
                {
                    SetFormError("No se encontró el certificado solicitado.");
                    return;
                }

                centroSeleccionado = FindCentroByCode(oCertifseman.Nrocen);
                socioSeleccionado = FindSocioByCode(oCertifseman.Nrocri);
                estadoOriginal = ClonarCertificado(oCertifseman);
            }
            catch (Exception ex)
            {
                SetFormError($"No se pudo cargar el certificado: {ex.Message}");
            }
        }

        SyncSelectionsToModel();
        oCertifseman.TipEnv ??= "PAJUELAS";

    }
    async Task Guardar()
    {
        if (isBusy)
        {
            return;
        }

        ClearMessages();
        NormalizeFormFields();
        SyncSelectionsToModel();

        if (!ValidateForm())
        {
            SetFormError("Revisá los datos marcados antes de guardar.");
            return;
        }

        isBusy = true;

        try
        {
            var (dosisOriginales, dosisRemanentes) = ParseDosisValues();

            if (Id == 0)
            {
                oCertifseman.NrDosi = dosisRemanentes ?? dosisOriginales;

                var createResponse = await _certifsemanServicio.Crear(oCertifseman);
                if (createResponse.Exito != 1 || createResponse.List == null)
                {
                    ShowBackendErrors(createResponse);
                    return;
                }

                SetFormSuccess("Certificado creado correctamente.");
                await Swal.FireAsync("Éxito", "Certificado creado correctamente.", SweetAlertIcon.Success);
                await ModalInstance.CloseAsync(ModalResult.Ok("Certificado guardado."));
            }
            else
            {
                oCertifseman.NrDosi = dosisRemanentes;
                var editResponse = await _certifsemanServicio.Editar(oCertifseman);
                if (editResponse.Exito != 1)
                {
                    ShowBackendErrors(editResponse);
                    return;
                }

                // El mail es un extra: si falla, la edición ya quedó guardada y no
                // tiene sentido retener al usuario en el formulario.
                var errorAviso = enviarAvisoPorMail ? await EnviarAvisoEdicionAsync() : null;

                if (errorAviso != null)
                {
                    SetFormSuccess("Certificado editado correctamente.");
                    await Swal.FireAsync(
                        "Certificado guardado",
                        $"El certificado se editó correctamente, pero no se pudo enviar el aviso por mail. {errorAviso}",
                        SweetAlertIcon.Warning);
                    await ModalInstance.CloseAsync(ModalResult.Ok("Certificado guardado."));
                    return;
                }

                SetFormSuccess("Certificado editado correctamente.");
                await Swal.FireAsync(
                    "Éxito",
                    enviarAvisoPorMail
                        ? "Certificado editado correctamente y aviso enviado por mail."
                        : "Certificado editado correctamente.",
                    SweetAlertIcon.Success);
                await ModalInstance.CloseAsync(ModalResult.Ok("Certificado guardado."));
            }
        }
        catch (Exception ex)
        {
            SetFormError($"Ocurrió un error al guardar el certificado: {ex.Message}");
            await Swal.FireAsync("Error", $"Ocurrió un error al guardar el certificado: {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            isBusy = false;
        }
    }

    async Task cancel()
    {
        await ModalInstance.CloseAsync(ModalResult.Cancel($"Form was cancelled"));

    }

    private async Task<IEnumerable<CentrosiumDTO>> BusquedaCentros(string searchText)
    {
        ultimaBusquedaCentro = searchText;
        var query = Normalizar(searchText);
        var result = centros
            .Where(x => Normalizar(x.Nombre).Contains(query) || Normalizar(x.Nrocen).Contains(query))
            .OrderBy(x => x.Nombre)
            .ToList();
        return await Task.FromResult(result);
    }

    private async Task<IEnumerable<SocioDTO>> BusquedaSocios(string searchText)
    {
        ultimaBusquedaSocio = searchText;
        var query = Normalizar(searchText);
        var result = socios
            .Where(x => x.Criador == "S" &&
                        (Normalizar(x.Nombre).Contains(query) || Normalizar(x.Scod).Contains(query)))
            .OrderBy(x => x.Nombre)
            .ToList();
        return await Task.FromResult(result);
    }

    /// <summary>
    /// El alta pide solamente los datos que identifican al certificado. La edición
    /// no los vuelve a reclamar: muchos certificados históricos llegaron incompletos
    /// desde el sistema viejo y exigirlos impedía, por ejemplo, corregir las dosis.
    /// En edición solo se avisa si el usuario vació un dato que estaba cargado.
    /// </summary>
    private bool ValidateForm()
    {
        validationErrors.Clear();

        SyncSelectionsToModel();

        var esAlta = Id == 0;
        int? dosisOriginales = null;

        void Requerido(string? actual, string? original, string mensajeAlta, string campo)
        {
            if (!string.IsNullOrWhiteSpace(actual))
            {
                return;
            }

            if (esAlta)
            {
                validationErrors.Add(mensajeAlta);
            }
            else if (!string.IsNullOrWhiteSpace(original))
            {
                validationErrors.Add(MensajeDatoBorrado(campo));
            }
        }

        void NoVaciar(string? actual, string? original, string campo)
        {
            if (!esAlta && string.IsNullOrWhiteSpace(actual) && !string.IsNullOrWhiteSpace(original))
            {
                validationErrors.Add(MensajeDatoBorrado(campo));
            }
        }

        Requerido(oCertifseman.Nrocri, estadoOriginal?.Nrocri,
            DescribirSeleccionFaltante("socio", ultimaBusquedaSocio), "el socio");

        if (string.IsNullOrWhiteSpace(oCertifseman.Nrocen) && centroSeleccionado != null)
        {
            // El centro existe pero le falta el NROCEN, que es el dato con el que
            // se vincula el certificado. Solo molesta si lo está eligiendo ahora.
            if (esAlta || !string.IsNullOrWhiteSpace(estadoOriginal?.Nrocen))
            {
                validationErrors.Add($"El centro \"{centroSeleccionado.Nombre}\" no tiene cargado el número de centro, que es el dato con el que se vincula el certificado. Hay que completarlo en el centro antes de poder usarlo.");
            }
        }
        else
        {
            Requerido(oCertifseman.Nrocen, estadoOriginal?.Nrocen,
                DescribirSeleccionFaltante("centro", ultimaBusquedaCentro), "el centro");
        }

        Requerido(oCertifseman.NroCert, estadoOriginal?.NroCert, "Ingresá el número de certificado.", "el número de certificado");
        Requerido(oCertifseman.Hba, estadoOriginal?.Hba, "Ingresá el HBA.", "el HBA");

        NoVaciar(oCertifseman.TipoCert, estadoOriginal?.TipoCert, "el tipo de certificado");
        NoVaciar(oCertifseman.NomDad, estadoOriginal?.NomDad, "el nombre");
        NoVaciar(oCertifseman.Apodo, estadoOriginal?.Apodo, "el tipo de toro");
        NoVaciar(oCertifseman.NrDosiOr, estadoOriginal?.NrDosiOr, "la cantidad original de dosis");

        if (!string.IsNullOrWhiteSpace(oCertifseman.NrDosiOr))
        {
            if (!int.TryParse(oCertifseman.NrDosiOr, out var parsedOriginales) || parsedOriginales < 0)
            {
                validationErrors.Add("La cantidad original de dosis debe ser un número válido y no negativo.");
            }
            else
            {
                dosisOriginales = parsedOriginales;
            }
        }

        if (oCertifseman.NrDosi.HasValue)
        {
            if (oCertifseman.NrDosi.Value < 0)
            {
                validationErrors.Add("La cantidad de dosis remanentes no puede ser negativa.");
            }
            else if (dosisOriginales.HasValue && oCertifseman.NrDosi.Value > dosisOriginales.Value && DosisTocadas())
            {
                validationErrors.Add("La cantidad de dosis remanentes no puede ser mayor a la cantidad original.");
            }
        }

        return validationErrors.Count == 0;
    }

    /// <summary>
    /// Hay certificados viejos guardados con más dosis remanentes que originales.
    /// Si el usuario no tocó ninguno de los dos números, no lo trabamos por un
    /// desajuste que no generó él.
    /// </summary>
    private bool DosisTocadas()
    {
        if (Id == 0 || estadoOriginal == null)
        {
            return true;
        }

        var originalCantidad = (estadoOriginal.NrDosiOr ?? string.Empty).Trim();
        var actualCantidad = (oCertifseman.NrDosiOr ?? string.Empty).Trim();

        return oCertifseman.NrDosi != estadoOriginal.NrDosi
            || !string.Equals(originalCantidad, actualCantidad, StringComparison.Ordinal);
    }

    private void OnCentroChanged(CentrosiumDTO? centro)
    {
        centroSeleccionado = centro;
        oCertifseman.Nrocen = centro?.Nrocen?.Trim();
        ultimaBusquedaCentro = null;
        ClearMessages();
    }

    private void OnSocioChanged(SocioDTO? socio)
    {
        socioSeleccionado = socio;
        oCertifseman.Nrocri = socio?.Scod?.Trim();
        ultimaBusquedaSocio = null;
        ClearMessages();
    }

    private static string DescribirCentro(CentrosiumDTO? centro)
    {
        if (centro is null)
        {
            return string.Empty;
        }

        return string.IsNullOrWhiteSpace(centro.Nrocen)
            ? $"{centro.Nombre} (sin nro. de centro)"
            : $"{centro.Nombre} ({centro.Nrocen.Trim()})";
    }

    /// <summary>
    /// Compara ignorando mayusculas, acentos, espacios y puntuacion, para que
    /// "SEMEX ARGENTINA S.A." matchee con "Semex Argentina SA".
    /// </summary>
    private static string Normalizar(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var descompuesto = value.Normalize(NormalizationForm.FormD);
        var sb = new StringBuilder(descompuesto.Length);

        foreach (var ch in descompuesto)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(ch) == UnicodeCategory.NonSpacingMark)
            {
                continue;
            }

            if (char.IsLetterOrDigit(ch))
            {
                sb.Append(char.ToUpperInvariant(ch));
            }
        }

        return sb.ToString();
    }

    /// <summary>
    /// El typeahead deja el texto tipeado a la vista aunque no se haya elegido un
    /// item de la lista, asi que el campo "parece" completo pero la seleccion es
    /// null. Si ese texto identifica a un unico centro, lo damos por elegido en
    /// vez de rechazar el formulario.
    /// </summary>
    private CentrosiumDTO? ResolverCentroDesdeTexto(string? texto)
    {
        var clave = Normalizar(texto);
        if (clave.Length == 0)
        {
            return null;
        }

        var exactos = centros
            .Where(x => Normalizar(x.Nombre) == clave || Normalizar(x.Nrocen) == clave)
            .ToList();
        if (exactos.Count == 1)
        {
            return exactos[0];
        }
        if (exactos.Count > 1)
        {
            return null;
        }

        var parciales = centros
            .Where(x => Normalizar(x.Nombre).Contains(clave) || Normalizar(x.Nrocen).Contains(clave))
            .ToList();

        return parciales.Count == 1 ? parciales[0] : null;
    }

    private SocioDTO? ResolverSocioDesdeTexto(string? texto)
    {
        var clave = Normalizar(texto);
        if (clave.Length == 0)
        {
            return null;
        }

        var candidatos = socios.Where(x => x.Criador == "S").ToList();

        var exactos = candidatos
            .Where(x => Normalizar(x.Nombre) == clave || Normalizar(x.Scod) == clave)
            .ToList();
        if (exactos.Count == 1)
        {
            return exactos[0];
        }
        if (exactos.Count > 1)
        {
            return null;
        }

        var parciales = candidatos
            .Where(x => Normalizar(x.Nombre).Contains(clave) || Normalizar(x.Scod).Contains(clave))
            .ToList();

        return parciales.Count == 1 ? parciales[0] : null;
    }

    private void NormalizeFormFields()
    {
        oCertifseman.Apodo = oCertifseman.Apodo?.Trim();
        oCertifseman.TipoCert = oCertifseman.TipoCert?.Trim();
        oCertifseman.NroCert = oCertifseman.NroCert?.Trim();
        oCertifseman.Hba = oCertifseman.Hba?.Trim();
        oCertifseman.Tatpart = oCertifseman.Tatpart?.Trim();
        oCertifseman.NomDad = oCertifseman.NomDad?.Trim();
        oCertifseman.NrInsd = oCertifseman.NrInsd?.Trim();
        oCertifseman.NrTsan = oCertifseman.NrTsan?.Trim();
        oCertifseman.NrDosiOr = oCertifseman.NrDosiOr?.Trim();
        oCertifseman.TipEnv = string.IsNullOrWhiteSpace(oCertifseman.TipEnv) ? "PAJUELAS" : oCertifseman.TipEnv.Trim();
        oCertifseman.Variedad = oCertifseman.Variedad?.Trim();
        oCertifseman.Apodacion = oCertifseman.Apodacion?.Trim();
    }

    private void SyncSelectionsToModel()
    {
        if (socioSeleccionado == null)
        {
            socioSeleccionado = FindSocioByCode(oCertifseman.Nrocri)
                ?? ResolverSocioDesdeTexto(ultimaBusquedaSocio);
        }

        if (centroSeleccionado == null)
        {
            centroSeleccionado = FindCentroByCode(oCertifseman.Nrocen)
                ?? ResolverCentroDesdeTexto(ultimaBusquedaCentro);
        }

        oCertifseman.Nrocri = socioSeleccionado?.Scod?.Trim() ?? oCertifseman.Nrocri?.Trim();
        oCertifseman.Nrocen = centroSeleccionado?.Nrocen?.Trim() ?? oCertifseman.Nrocen?.Trim();
    }

    private (int? dosisOriginales, int? dosisRemanentes) ParseDosisValues()
    {
        int? dosisOriginales = int.TryParse(oCertifseman.NrDosiOr, out var parsed) ? parsed : null;

        return (dosisOriginales, oCertifseman.NrDosi);
    }

    private SocioDTO? FindSocioByCode(string? scod)
        => socios.FirstOrDefault(x => string.Equals(x.Scod?.Trim(), scod?.Trim(), StringComparison.OrdinalIgnoreCase));

    private CentrosiumDTO? FindCentroByCode(string? nrocen)
        => centros.FirstOrDefault(x => string.Equals(x.Nrocen?.Trim(), nrocen?.Trim(), StringComparison.OrdinalIgnoreCase));

    private void ShowBackendErrors(Respuesta<CertifsemanDTO>? response)
    {
        validationErrors.Clear();
        var message = response?.Mensaje?.Trim();

        if (string.IsNullOrWhiteSpace(message))
        {
            validationErrors.Add("No se pudo guardar el certificado.");
        }
        else
        {
            validationErrors.AddRange(message.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
        }

        formMessage = null;
        formMessageCss = "alert alert-danger";
    }

    private void SetFormError(string message)
    {
        formMessageCss = "alert alert-danger";
        formMessage = message;
    }

    private void SetFormSuccess(string message)
    {
        validationErrors.Clear();
        formMessageCss = "alert alert-success";
        formMessage = message;
    }

    private void ClearMessages()
    {
        validationErrors.Clear();
        formMessage = null;
        formMessageCss = "alert alert-danger";
    }

    private static string DescribirSeleccionFaltante(string campo, string? textoTipeado)
    {
        // Distinguir "no escribiste nada" de "escribiste algo que no resolvimos"
        // evita el caso donde el campo se ve completo y el error dice "seleccioná".
        return string.IsNullOrWhiteSpace(textoTipeado)
            ? $"Seleccioná un {campo}."
            : $"\"{textoTipeado.Trim()}\" no coincide con un único {campo} de la lista. Elegí uno del desplegable.";
    }

    private string DescribirDestinatarioAviso()
    {
        if (socioSeleccionado == null)
        {
            return "No se pudo identificar al socio del certificado, así que el aviso no se va a poder enviar.";
        }

        var destino = string.IsNullOrWhiteSpace(socioSeleccionado.Mail)
            ? "el socio no tiene mail cargado"
            : socioSeleccionado.Mail.Trim();

        return $"Se envía a {socioSeleccionado.Nombre} ({destino}) con copia a planteles@hereford.org.ar.";
    }

    /// <summary>
    /// Devuelve null si el aviso salió bien, o el motivo de la falla.
    /// </summary>
    private async Task<string?> EnviarAvisoEdicionAsync()
    {
        if (socioSeleccionado == null)
        {
            return "No se pudo identificar al socio del certificado para saber a qué dirección enviarlo.";
        }

        var datos = new CertificadoEmailDatos
        {
            NroCert = oCertifseman.NroCert,
            TipoCert = oCertifseman.TipoCert,
            SocioNombre = socioSeleccionado.Nombre,
            SocioCodigo = oCertifseman.Nrocri,
            CentroNombre = centroSeleccionado?.Nombre ?? oCertifseman.Nrocen,
            ToroNombre = oCertifseman.NomDad,
            ToroHba = oCertifseman.Hba,
            ToroTatuaje = oCertifseman.Tatpart,
            DosisOriginales = oCertifseman.NrDosiOr,
            DosisRemanentes = oCertifseman.NrDosi?.ToString(),
            TipoEnvase = oCertifseman.TipEnv
        };

        var request = new
        {
            Vendedor = socioSeleccionado.Id,
            Comprador = socioSeleccionado.Id,
            Mail = CertificadoEmailTemplates.BuildEdicionCertificadoHtml(datos, ConstruirCambios(), DateTime.Now),
            Direccion = (string?)null,
            Asunto = CertificadoEmailTemplates.BuildAsunto(oCertifseman.NroCert)
        };

        try
        {
            var response = await http.PostAsJsonAsync("api/Transan/SendMail", request);
            if (response.IsSuccessStatusCode)
            {
                return null;
            }

            var serverMessage = (await response.Content.ReadAsStringAsync())?.Trim();
            return string.IsNullOrWhiteSpace(serverMessage) ? "El servidor rechazó el envío." : serverMessage;
        }
        catch (Exception ex)
        {
            return ex.Message;
        }
    }

    private List<CambioCertificado> ConstruirCambios()
    {
        var cambios = new List<CambioCertificado>();
        if (estadoOriginal == null)
        {
            return cambios;
        }

        void Comparar(string etiqueta, string? antes, string? ahora)
        {
            var a = (antes ?? string.Empty).Trim();
            var b = (ahora ?? string.Empty).Trim();
            if (!string.Equals(a, b, StringComparison.Ordinal))
            {
                cambios.Add(new CambioCertificado(etiqueta, a, b));
            }
        }

        Comparar("Tipo de certificado", estadoOriginal.TipoCert, oCertifseman.TipoCert);
        Comparar("Nro. de certificado", estadoOriginal.NroCert, oCertifseman.NroCert);
        Comparar("Socio", NombreSocio(estadoOriginal.Nrocri), NombreSocio(oCertifseman.Nrocri));
        Comparar("Centro", NombreCentro(estadoOriginal.Nrocen), NombreCentro(oCertifseman.Nrocen));
        Comparar("Fecha de venta", FormatoFecha(estadoOriginal.Fecvta), FormatoFecha(oCertifseman.Fecvta));
        Comparar("HBA", estadoOriginal.Hba, oCertifseman.Hba);
        Comparar("Tatuaje", estadoOriginal.Tatpart, oCertifseman.Tatpart);
        Comparar("Nombre", estadoOriginal.NomDad, oCertifseman.NomDad);
        Comparar("Apodo", estadoOriginal.Apodacion, oCertifseman.Apodacion);
        Comparar("Tipo de toro", estadoOriginal.Apodo, oCertifseman.Apodo);
        Comparar("Tip/ADN", estadoOriginal.NrTsan, oCertifseman.NrTsan);
        Comparar("Macho dador", estadoOriginal.NrInsd, oCertifseman.NrInsd);
        Comparar("Variedad", estadoOriginal.Variedad, oCertifseman.Variedad);
        Comparar("Tipo de envase", estadoOriginal.TipEnv, oCertifseman.TipEnv);
        Comparar("Cantidad original de dosis", estadoOriginal.NrDosiOr, oCertifseman.NrDosiOr);
        Comparar("Dosis remanentes", estadoOriginal.NrDosi?.ToString(), oCertifseman.NrDosi?.ToString());

        return cambios;
    }

    private string? NombreSocio(string? scod)
    {
        if (string.IsNullOrWhiteSpace(scod))
        {
            return null;
        }

        var socio = FindSocioByCode(scod);
        return socio?.Nombre ?? scod.Trim();
    }

    private string? NombreCentro(string? nrocen)
    {
        if (string.IsNullOrWhiteSpace(nrocen))
        {
            return null;
        }

        var centro = FindCentroByCode(nrocen);
        return centro?.Nombre ?? nrocen.Trim();
    }

    private static string? FormatoFecha(DateTime? fecha)
        => fecha?.ToString("dd/MM/yyyy");

