@code {
    [CascadingParameter] public IModalService Modal { get; set; } = default!;
    public RadzenDataGrid<CertifsemanDTO>? grid;
    int currentPage;
    int cantotal;
    SocioDTO? socioSeleccionado;
    List<SocioDTO> socios = new();
    bool isLoading = false;
    public bool allowFiltering = false;
    public Respuesta<List<CertifsemanDTO>> oRespuesta = new Respuesta<List<CertifsemanDTO>>();

    protected override async Task OnInitializedAsync()
    {
        await Get();
    }

    async Task Get()
    {
        var esSocio = await UserHasRole("Socio");

        if (!esSocio)
        {
            var rta = await _socioServicio.LimitadosFiltrados(0, 0);
            socios = rta.List;
            await CargarCertificadosAsync(0, 15, string.Empty);
        }
        else
        {
            oRespuesta = await _certifsemanServicio.LimitadosFiltrados(0, 0, string.Empty);
            oRespuesta.List = OrderCertificadosByCreation(RemoveDuplicatesByBusinessKey(oRespuesta.List));
            cantotal = oRespuesta.List.Count();
        }
    }

    public static List<CertifsemanDTO> RemoveDuplicatesByBusinessKey(List<CertifsemanDTO>? items)
    {
        if (items == null || items.Count == 0)
        {
            return new List<CertifsemanDTO>();
        }

        var seenKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var uniqueItems = new List<CertifsemanDTO>();

        foreach (var item in items)
        {
            var key = BuildBusinessKey(item);
            if (seenKeys.Add(key))
            {
                uniqueItems.Add(item);
            }
        }

        return uniqueItems;
    }

    private static List<CertifsemanDTO> OrderCertificadosByCreation(IEnumerable<CertifsemanDTO>? items)
        => (items ?? Enumerable.Empty<CertifsemanDTO>())
            .OrderByDescending(x => x.FchUsu.HasValue)
            .ThenByDescending(x => x.FchUsu)
            .ThenByDescending(x => x.Id)
            .ToList();

    private async Task<bool> UserHasRole(string role)
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authenticationState.User.IsInRole(role);
    }

    public void CambiarModoFiltro()
    {
        allowFiltering = !allowFiltering;
        StateHasChanged();
    }

    async Task delete(int id)
    {
        currentPage = grid.CurrentPage;
        var response = await _certifsemanServicio.Eliminar(id);
        await grid.Reload();
        if (response)
        {
            oRespuesta.List.Remove(oRespuesta.List.Where(x => x.Id == id).FirstOrDefault());

            if (currentPage >= grid.Count / grid.PageSize && grid.Count != 0)
            {
                await grid.GoToPage(currentPage - 1);
            }
            else if (grid.Count != 0)
            {
                await grid.GoToPage(currentPage);
            }
            StateHasChanged();
        }
    }

    public async Task alertaDelete(int id)
    {
        SweetAlertResult result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "¿Está seguro?",
            Text = "Se eliminará este certificado",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Eliminar",
            CancelButtonText = "Cancelar"
        });

        if (!string.IsNullOrEmpty(result.Value))
        {
            delete(id);
        }
    }

    async Task add(int Id)
    {
        int numero = Id;
        if (numero != 0)
        {
            currentPage = grid.CurrentPage;
            try
            {
                var parameters = new ModalParameters();
                parameters.Add(nameof(AddCertificado.Id), Id);
                var options = new ModalOptions()
                {
                    Size = ModalSize.ExtraLarge
                };
                var formModal = Modal.Show<AddCertificado>("Editar Certificado", parameters, options);
                var result = await formModal.Result;
                if (result.Cancelled)
                {
                    Console.WriteLine("Modal was cancelled");
                    await grid.GoToPage(currentPage);
                }
                else
                {
                    if (socioSeleccionado == null)
                    {
                        await Get();
                        await grid.Reload();
                        await grid.GoToPage(currentPage);
                    }
                    else
                    {
                        await CargarCertificadosAsync(0, 15, BuildSocioFilter());
                        await grid.Reload();
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
            }
        }
        else
        {
            var options = new ModalOptions()
            {
                Size = ModalSize.ExtraLarge
            };
            var formModal = Modal.Show<AddCertificado>("Agregar Certificado", options);
            var result = await formModal.Result;

            if (result.Cancelled)
            {
                Console.WriteLine("Modal was cancelled");
                await grid.GoToPage(currentPage);
            }
            else
            {
                if (socioSeleccionado == null)
                {
                    await RecargarDatos();
                    await grid.GoToPage(currentPage);
                }
                else
                {
                    await CargarCertificadosAsync(0, 15, BuildSocioFilter());
                    await grid.Reload();
                }
            }
        }
    }

    async Task LoadData(LoadDataArgs args)
    {
        isLoading = true;

        var skip = args.Skip ?? 0;
        var take = args.Top ?? 15;
        var filtro = CombineFilters(args.Filter, BuildSocioFilter());

        try
        {
            await CargarCertificadosAsync(skip, take, filtro);
        }
        finally
        {
            isLoading = false;
        }
    }

    public async Task PaginaReporte()
    {
        nav.NavigateTo($"/reporteprint/0");
    }

    private async Task<IEnumerable<SocioDTO>> BusquedaSocios(string searchText)
    {
        var result = socios
            .Where(x => !string.IsNullOrWhiteSpace(x.Nombre) && x.Nombre.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .ToList();

        return await Task.FromResult(result);
    }

    private readonly SeleccionTypeahead seleccionSocio = new();

    private Task OnSocioSeleccionadoChanged(SocioDTO? socio)
    {
        socioSeleccionado = socio;

        if (grid is null)
        {
            return Task.CompletedTask;
        }

        currentPage = 0;

        // La recarga de la grilla corre fuera del handler: si la esperamos aca,
        // BlazoredTypeahead no cierra el desplegable hasta que vuelve el request
        // (ver SeleccionTypeahead).
        seleccionSocio.Ejecutar(() => grid.FirstPage(true),
                                () => InvokeAsync(StateHasChanged),
                                nameof(OnSocioSeleccionadoChanged));
        return Task.CompletedTask;
    }

    public async Task RecargarDatos()
    {
        isLoading = true;

        try
        {
            await CargarCertificadosAsync(0, 15, BuildSocioFilter());
        }
        finally
        {
            isLoading = false;
        }

        await grid.Reload();
    }

    private async Task CargarCertificadosAsync(int skip, int take, string? filtro)
    {
        oRespuesta = await _certifsemanServicio.LimitadosFiltrados(skip, take, filtro ?? string.Empty);
        oRespuesta.List = OrderCertificadosByCreation(RemoveDuplicatesByBusinessKey(oRespuesta.List));

        if (string.IsNullOrWhiteSpace(filtro))
        {
            var rt = await _certifsemanServicio.CantidadTotal();
            cantotal = rt.List;
            return;
        }

        var filteredResponse = await _certifsemanServicio.LimitadosFiltrados(0, 0, filtro);
        cantotal = RemoveDuplicatesByBusinessKey(filteredResponse.List).Count;
    }

    private string BuildSocioFilter()
        => socioSeleccionado?.Id > 0 ? $"Socio.Id == {socioSeleccionado.Id}" : string.Empty;

    private static string CombineFilters(string? gridFilter, string? socioFilter)
    {
        var hasGridFilter = !string.IsNullOrWhiteSpace(gridFilter);
        var hasSocioFilter = !string.IsNullOrWhiteSpace(socioFilter);

        if (!hasGridFilter)
        {
            return socioFilter ?? string.Empty;
        }

        if (!hasSocioFilter)
        {
            return gridFilter!;
        }

        return $"({gridFilter}) && ({socioFilter})";
    }

    private static string BuildBusinessKey(CertifsemanDTO item)
        => $"{NormalizeKeyPart(item.Nrocri)}|{NormalizeKeyPart(item.NroCert)}|{NormalizeKeyPart(item.Hba)}";

    private static string NormalizeKeyPart(string? value)
        => (value ?? string.Empty).Trim();
}
