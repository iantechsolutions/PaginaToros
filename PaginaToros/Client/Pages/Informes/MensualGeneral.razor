    /// <summary>
    /// PDF vía impresión del navegador: mientras se imprime se muestran todos los desgloses completos
    /// (sin tabs ni paginación) y después se vuelve a la vista normal.
    /// </summary>
    private async Task Print()
    {
        if (!confirmado || printing) return;
        printing = true;
        StateHasChanged();
        await Task.Delay(80);
        try
        {
            await _js.InvokeVoidAsync("window.print");
        }
        finally
        {
            printing = false;
        }
    }

    /* ======== DICCIONARIOS DE PIVOTE ======== */
    InspeccionCounters totalesGeneral = new();
    Dictionary<string, InspeccionCounters> byProvince = new();             // provCode -> Counters
    Dictionary<string, InspeccionCounters> byInspector = new();            // inspCode -> Counters
    Dictionary<string, InspeccionCounters> byMonth = new();                // "yyyy-MM" -> Counters
    Dictionary<(string month, string prov), InspeccionCounters> byMonthProvince = new();
    Dictionary<(string month, string insp), InspeccionCounters> byMonthInspector = new();

    /* ======== HELPERS ======== */
    static TTarget GetOrCreate<TKey, TTarget>(Dictionary<TKey, TTarget> dict, TKey key)
        where TKey : notnull
        where TTarget : new()
    {
        if (!dict.TryGetValue(key, out var val))
        {
            val = new TTarget();
            dict[key] = val;
        }
        return val;
    }

    string MonthKey(DateTime? dt)
    {
        if (!dt.HasValue) return "(Sin fecha)";
        return dt.Value.ToString("yyyy-MM");
    }

    string SafeProvName(string? code)
    {
        var c = (code ?? "").Trim();
        if (traductorProvinciaInverso.TryGetValue(c, out var name) && !string.IsNullOrWhiteSpace(name))
            return name;
        return "(Sin provincia)";
    }

    string SafeInspName(string? code)
    {
        return inspectNameByCode.TryGetValue((code ?? "").Trim(), out var n) && !string.IsNullOrWhiteSpace(n)
            ? n : "(Sin inspector)";
    }

    string NormalizeProvKey(string? code)
    {
        var c = (code ?? "").Trim();
        // Si existe en el traductor y tiene nombre, uso el código real
        if (traductorProvinciaInverso.TryGetValue(c, out var name) && !string.IsNullOrWhiteSpace(name))
            return c;
        // Si no, mando a una clave canónica
        return "__NONE_PROV__";
    }

    string NormalizeInspKey(string? code)
    {
        var c = (code ?? "").Trim();
        if (c != "" && inspectNameByCode.ContainsKey(c)) return c;
        return "__NONE_INSP__";
    }

    // Helper para "Por Provincia (del inspector)"
    InspeccionCounters Aggregate(IEnumerable<Resin6DTO> items)
    {
        var c = new InspeccionCounters();
        foreach (var x in items) c.AddFrom(x);
        return c;
    }
}
